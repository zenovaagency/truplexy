---
import Docs from '../../layouts/Docs.astro';
import Button from '../../components/ui/Button.astro';
import ChannelIcon from '../../components/ui/ChannelIcon';
import CodeTabs from '../../components/docs/CodeTabs.astro';
import DataTable from '../../components/docs/DataTable.astro';
import Flow from '../../components/docs/Flow.astro';
import { SITE } from '../../data/site';
import { channel } from '../../data/channels';
import { OVERVIEW_IDS } from '../../data/channel-pages';
import { COMMON_TROUBLESHOOTING, DOC_IDS, GUIDES, availability, docsHref, type DocId } from '../../data/setup-guides';
import { codeTabs, webhookTabs, verifyTabs } from '../../data/snippets';
import { CHAT_API_ENDPOINTS, CUSTOMER_RULES } from '../../../dashboard/src/features/integrations/snippets/chat-api';

export function getStaticPaths() {
  return DOC_IDS.map((id) => ({ params: { id } }));
}

const id = Astro.params.id as DocId;
const ch = channel(id);
const guide = GUIDES[id];
const { kind } = guide;
const plan = availability(guide.planLabel);
const overview = (OVERVIEW_IDS as string[]).includes(id) ? `/channels/${id}` : null;

const isApi = id === 'api';
const isHooks = id === 'webhooks';
const isWordPress = id === 'wordpress';
// Channels whose messages your server relays (customers write there).
const relays = kind === 'customer';

const code = codeTabs(id);
const hooks = webhookTabs(id);
const customHooks = isApi ? webhookTabs('custom') : [];

const events = [
  ['message.created', 'A person replied to a ticket of a chat API conversation.', '{ conversation_id, message }'],
  ['ticket.updated', 'Such a ticket was opened, or its status or escalation changed.', '{ conversation_id, ticket }'],
];
const headers = [
  ['X-Truplexy-Event', 'The event type.'],
  ['X-Truplexy-Delivery', 'The event ID. A retry reuses it, so deduplicate on it.'],
  ['X-Truplexy-Signature', '`t=<unix seconds>,v1=<hex HMAC-SHA256 of "<t>.<raw body>">`'],
];

const heading = isHooks
  ? 'Receive Truplexy webhooks'
  : isApi
    ? 'Build on the Truplexy chat API'
    : isWordPress
      ? 'Install the WordPress plugin'
      : `Connect ${ch.name} to Truplexy`;

const platformHeading = kind === 'widget' ? '2. Install the plugin' : `2. Set up ${ch.name}`;
const toc: [string, string][] = [['before', 'Before you start']];
if (isHooks) {
  toc.push(['setup', '1. Create the webhook'], ['events', 'Events'], ['delivery', 'Delivery'], ['verify', 'Verify the signature'], ['receiver', 'A receiver']);
} else {
  toc.push(['key', '1. Issue a chat key']);
  if (isApi) {
    toc.push(['calls', '2. Call the chat API'], ['code', '3. Add the server code'], ['status', 'Reading the reply'], ['custom-channel', 'Build a custom channel']);
  } else {
    toc.push(['platform', platformHeading]);
    if (code.length) toc.push(['code', kind === 'widget' ? 'The plugin' : '3. Add the server code']);
    if (hooks.length) toc.push(['replies', '4. Send team replies back']);
    else if (kind === 'widget') toc.push(['replies', 'Your team’s replies']);
    if (isWordPress) toc.push(['woocommerce', 'WooCommerce stores']);
  }
  if (relays || isApi) toc.push(['identity', 'Customer identity']);
}
toc.push(['try', 'Test it'], ['troubleshooting', 'Troubleshooting'], ['next', 'Next steps']);

const troubleshooting = [...guide.troubleshooting, ...(relays ? COMMON_TROUBLESHOOTING : [])];
const channelLabel = guide.channelType === 'website' ? 'Website' : guide.channelType === 'custom' ? 'Custom' : ch.name;
const where = kind === 'widget' ? 'your site' : ch.name;
const next = guide.next.slice(0, 3);
---

<Docs
  title={`${guide.name} setup guide — Truplexy`}
  description={guide.summary}
  breadcrumbs={[{ name: 'Docs', path: '/docs' }, { name: guide.name, path: `/docs/${id}` }]}
  eyebrow={`Setup guide · ${guide.name}`}
  heading={heading}
  lede={guide.summary}
  toc={toc}
>
  <Fragment slot="hero-top">
    <div class="mb-5 flex items-center gap-3">
      <span class="grid h-12 w-12 place-items-center rounded-2xl border border-line bg-surface shadow-sm" aria-hidden="true">
        <ChannelIcon id={id} size={24} />
      </span>
      {ch.status === 'soon' && <span class="soon-tag">Coming soon</span>}
    </div>
  </Fragment>
  <Fragment slot="hero-actions">
    <Button href={`${SITE.dashboardUrl}/`}>{isHooks ? 'Set up the webhook' : 'Get a chat key'}</Button>
    {overview && <Button href={overview} variant="ghost" arrow={false}>About {ch.name}</Button>}
  </Fragment>

  <h2 id="before">Before you start</h2>
  <ul>
    <li>A Truplexy account on <strong>{plan.text === 'Every plan' ? 'any plan' : plan.text}</strong>{plan.detail ? ` (${plan.detail})` : ''}.</li>
    {guide.needs.map((n) => <li>{n}</li>)}
  </ul>
  <p>What you’ll connect:</p>
  <Flow nodes={guide.flow} description={guide.flowLabel} />
  {guide.env.length > 0 && (
    <Fragment>
      <p>Secrets the code reads from the environment{isHooks ? '' : <Fragment>, besides <code>TRUPLEXY_CHAT_KEY</code></Fragment>}:</p>
      <DataTable headers={['Variable', 'What it is']} rows={guide.env} />
    </Fragment>
  )}

  {isHooks ? (
    <Fragment>
      <h2 id="setup">1. Create the webhook</h2>
      <ol>
        {guide.steps.map((s) => <li>{s}</li>)}
      </ol>
      <p>Each bot has one webhook. The URL is <code>https://</code>, up to 2000 characters, with no user name, password or <code>#</code> fragment. Saving with <code>enabled: false</code> pauses deliveries. Events are sent for conversations started through the chat API.</p>

      <h2 id="events">Events</h2>
      <DataTable headers={['Event', 'When', 'data']} rows={events} />
      <p>Each delivery is <code>{'{id, type, created_at, data}'}</code>. Notes, playground conversations and anything the integration did itself are not delivered.</p>

      <h2 id="delivery">Delivery</h2>
      <DataTable headers={['Header', 'Value']} rows={headers} />
      <p>Your receiver must answer <strong>2xx within 2.5 seconds</strong>. After no answer, a <code>429</code> or a <code>5xx</code>, the event is sent once more with the same delivery ID. A failed delivery shows in the webhook’s last delivery and never undoes the team’s change.</p>

      <h2 id="verify">Verify the signature</h2>
      <p>Compute the HMAC-SHA256 of <code>"&lt;t&gt;.&lt;raw body&gt;"</code> with your signing secret, compare it in constant time, and reject a <code>t</code> more than 5 minutes old. Use the raw bytes of the body, not re-serialised JSON.</p>
      <CodeTabs group="verify" remember="lang" label="Your server language" tabs={verifyTabs()} />

      <h2 id="receiver">A receiver</h2>
      <p>A complete receiver: it verifies the delivery, acknowledges at once, then acts on <code>message.created</code>.</p>
      {hooks.length > 0 && <CodeTabs group="receiver" remember="lang" label="Your server language" tabs={hooks} />}
    </Fragment>
  ) : (
    <Fragment>
      <h2 id="key">1. Issue a chat key</h2>
      <ol>
        <li>In the <a href={SITE.dashboardUrl}>dashboard</a>, open <strong>Integrations → Add a channel → {isApi ? 'REST API' : ch.name}</strong>.</li>
        {guide.channelType
          ? <li>Add a <strong>{channelLabel}</strong> channel, so tickets show where they came from, and issue its chat key.</li>
          : <li>Issue a chat key for your server.</li>}
        {isWordPress
          ? <li>Keep it for <code>wp-config.php</code> in step 2. Never put it in a theme file or a page: anyone could copy it.</li>
          : <li>Store it on your server as <code>TRUPLEXY_CHAT_KEY</code>, in <code>.env</code> or your host’s settings. Never put it in a website, mobile app or theme file: anyone could copy it.</li>}
      </ol>

      {isApi ? (
        <Fragment>
          <h2 id="calls">2. Call the chat API</h2>
          <ol>
            {guide.steps.map((s) => <li>{s}</li>)}
          </ol>
          <DataTable
            headers={['Method', 'Endpoint', 'Behavior']}
            rows={CHAT_API_ENDPOINTS.map(([method, path, sdk, description]) => [sdk, `\`${method} ${path}\``, description])}
          />
          <p>A channel-bound key supplies the channel automatically; <code>channel_id</code> can override it. Disabled channels return <code>CHANNEL_DISABLED</code>.</p>

          <h2 id="code">3. Add the server code</h2>
          <p>Server code only: never call the chat API from a browser or an app. The helper wraps every call above.</p>
          <CodeTabs group="code" remember="lang" label="Your server language" tabs={code} />

          <h2 id="status">Reading the reply</h2>
          <p>Show <code>reply</code> for answered, clarification and no-answer statuses. Offer a handoff button for <code>handoff_offered</code>: a handoff notifies the team while the AI continues, while an escalation silences the AI. For <code>escalated</code> and <code>context</code> the reply is null: send nothing.</p>

          <h2 id="custom-channel">Build a custom channel</h2>
          <p>To connect a platform without a ready-made guide (a messaging app, a game, an in-product chat), relay its messages through the calls above and treat it as its own channel:</p>
          <ol>
            <li>Under <strong>Integrations → Your channels</strong>, add a <strong>Custom</strong> channel and issue its chat key, so its tickets show where they came from.</li>
            <li>Choose a contact type for the people on your platform, such as <code>app</code> for your own user IDs, and send it with <code>PUT /customer</code>. Add any other contacts you know, like an email address, so the same person is matched across channels.</li>
            <li>Keep one Truplexy conversation per thread on your platform, and store that mapping in your database.</li>
            <li>Set up the <a href="/docs/webhooks">webhook</a> and deliver your team’s replies from <code>message.created</code> back on your platform. Webhooks are on <strong>{availability('Webhooks').text}</strong>.</li>
          </ol>
          {customHooks.length > 0 && <CodeTabs group="receiver" remember="lang" label="Your server language" tabs={customHooks} />}
          <p>Add <code>TRUPLEXY_WEBHOOK_SECRET</code> (the webhook’s signing secret, <code>whsec_…</code>) to your environment for the receiver.</p>
        </Fragment>
      ) : (
        <Fragment>
          <h2 id="platform">{platformHeading}</h2>
          <ol>
            {guide.steps.map((s) => <li>{s}</li>)}
          </ol>

          {code.length > 0 && (
            <Fragment>
              <h2 id="code">{kind === 'widget' ? 'The plugin' : '3. Add the server code'}</h2>
              {kind === 'widget' ? (
                <p>One file is the route and the widget. Save it, activate it, and the chat button appears on every page.</p>
              ) : (
                <p>This handler keeps one Truplexy conversation per customer thread, asks Truplexy for the reply and sends it back on {where}. The second file calls the chat API; it is the same on every channel. The sample keeps threads in memory: use your database in production.</p>
              )}
              <CodeTabs group="code" remember="lang" label="Your server language" tabs={code} />
            </Fragment>
          )}

          {hooks.length > 0 ? (
            <Fragment>
              <h2 id="replies">4. Send team replies back</h2>
              <p>When someone replies from Tickets, Truplexy calls your webhook with <code>message.created</code>. Verify the signature, then deliver the message on {where}.</p>
              <p>Set the webhook up under <strong>Integrations → Webhook</strong> and keep its signing secret as <code>TRUPLEXY_WEBHOOK_SECRET</code>; the <a href="/docs/webhooks">webhooks guide</a> has the full contract.</p>
              <CodeTabs group="receiver" remember="lang" label="Your server language" tabs={hooks} />
            </Fragment>
          ) : kind === 'widget' ? (
            <Fragment>
              <h2 id="replies">Your team’s replies</h2>
              <p>There’s no webhook to set up. When someone replies from Tickets, the chat shows it live, or within a few seconds where live updates aren’t available. Visitors keep their conversation when they reload or come back later.</p>
              <p>For every widget attribute, label and CSS variable, see the <a href="/docs/web-sdk">Website chat SDK</a>.</p>
            </Fragment>
          ) : null}

          {isWordPress && (
            <Fragment>
              <h2 id="woocommerce">WooCommerce stores</h2>
              <p>The same plugin runs on a WooCommerce store. To let the assistant answer order questions:</p>
              <ol>
                <li>Create WooCommerce REST API keys (read access) under <strong>WooCommerce → Settings → Advanced → REST API</strong>, and keep them on your server.</li>
                <li>In the Truplexy dashboard, add an order-lookup tool under <strong>Tools</strong> that calls the WooCommerce REST API.</li>
                <li>Ask the chat about an order to check that the assistant uses it.</li>
              </ol>
              <p>WooCommerce is on <strong>{availability('WooCommerce').text}</strong>.</p>
            </Fragment>
          )}
        </Fragment>
      )}

      {(relays || isApi) && (
        <Fragment>
          <h2 id="identity">Customer identity</h2>
          <p>
            Truplexy matches people by their contacts, so one person across channels is one customer. {guide.contactType && (relays ? <Fragment>On {ch.name}, send the person as a <code>{guide.contactType}</code> contact; </Fragment> : <Fragment>Contact types are yours to choose: <code>{guide.contactType}</code> works well for your own users' IDs; </Fragment>)}add any others you know, such as an email address.
            Create the conversation with the returned <code>customer_id</code>, and its tickets inherit the customer and the channel.
          </p>
          <ul>{CUSTOMER_RULES.map((rule) => <li>{rule}</li>)}</ul>
        </Fragment>
      )}
    </Fragment>
  )}

  <h2 id="try">Test it</h2>
  {isHooks ? (
    <ul>
      <li>Open <strong>Integrations → Webhook</strong> and use <strong>Send test</strong>. Your receiver should get a <code>ping</code> and answer 2xx, even while deliveries are paused.</li>
      <li>Reply to a ticket from Tickets and check that <code>message.created</code> arrives with a valid signature.</li>
      <li>Escalate a ticket and check that <code>ticket.updated</code> arrives.</li>
    </ul>
  ) : (
    <ul>
      <li>Send a message {isApi ? 'through your integration' : `on ${where}`}. The reply should arrive within a few seconds.</li>
      {(relays || isApi) && <li>For an identified customer, open Customers and check the contact and conversation link. Any tickets should carry that customer too.</li>}
      <li>Ask for a person. The conversation shows up under Tickets → Handoffs.</li>
      <li>Take it over and reply from the ticket. Your reply should appear {isApi ? 'through your webhook' : `on ${where}`}.</li>
    </ul>
  )}

  <h2 id="troubleshooting">Troubleshooting</h2>
  <DataTable headers={['Problem', 'Fix']} rows={troubleshooting} codeFirst={false} />
  <p>Still stuck? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> with the <code>request_id</code> from the error.</p>

  <h2 id="next">Next steps</h2>
  <ul class="cards">
    {next.map((n) => (
      <li>
        <a href={docsHref(n)} class="card-link">
          <span class="icon"><ChannelIcon id={n} size={18} /></span>
          <span>
            <span class="name">{GUIDES[n].name}</span>
            <span class="blurb">{GUIDES[n].blurb}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Docs>
