---
import Docs from '../../layouts/Docs.astro';
import Button from '../../components/ui/Button.astro';
import CodeBlock from '../../components/docs/CodeBlock.astro';
import CodeTabs, { type Tab } from '../../components/docs/CodeTabs.astro';
import Flow from '../../components/docs/Flow.astro';
import { SITE } from '../../data/site';
// One source for the install recipes: the dashboard's Website chat guide shows the same ones.
import { SERVER_RECIPES, WIDGET_RECIPES, CUSTOMER_RECIPE } from '../../../dashboard/src/features/integrations/snippets/web-sdk';
import { CHAT_API_ENDPOINTS, CUSTOMER_RULES } from '../../../dashboard/src/features/integrations/snippets/chat-api';

const serverTabs: Tab[] = [
  ...SERVER_RECIPES,
  {
    id: 'wordpress',
    label: 'WordPress',
    files: [],
    html: `<ol>
<li>Download <a href="/downloads/truplexy-chat.zip">truplexy-chat.zip</a>. In WordPress, open <strong>Plugins → Add New → Upload Plugin</strong>, choose the zip and activate it.</li>
<li>Paste your chat key (dashboard: <strong>Integrations → WordPress</strong>) on the <strong>Settings → Truplexy Chat</strong> page that opens, then save. It says <em>Connected</em> when the key works.</li>
<li>Style the chat under <strong>Integrations → Chat widget</strong> in the Truplexy dashboard.</li>
</ol>
<p>The plugin is the route <em>and</em> the widget: it adds <code>/wp-json/truplexy/v1/chat</code> and the chat button to every page. It works for WooCommerce stores too. To keep the key out of the database, define <code>TRUPLEXY_CHAT_KEY</code> in <code>wp-config.php</code> instead.</p>`,
  },
  {
    id: 'other',
    label: 'Python, PHP, Go…',
    files: [],
    html: `<p>The route is one POST endpoint, so any server language can host it. The dashboard's Website chat guide has complete, tested versions for <strong>Python (FastAPI)</strong>, <strong>PHP</strong> and <strong>Go</strong>: pick <em>Another language</em> under step 2. To write your own, follow <a href="#protocol">the protocol</a>.</p>`,
  },
];

const attributes = [
  ['endpoint', 'Your route from step 2.', '/api/truplexy'],
  ['heading', 'The title in the header.', 'Your business name, read from Truplexy'],
  ['subtitle', 'The line under the title.', 'Ask us anything…'],
  ['greeting', 'The first message visitors see. Markdown works. An empty value hides it.', 'Hi there! How can we help you today?'],
  ['placeholder', 'The message box hint.', 'Write a message…'],
  ['accent', 'Any CSS colour, for the button, header and visitor bubbles.', '#0a0a0a'],
  ['avatar', 'An image URL for the header.', 'Your business logo, read from Truplexy, else a bot icon'],
  ['theme', '`light`, `dark`, or `auto` to follow the visitor’s device.', 'light'],
  ['position', '`right` or `left`.', 'right'],
  ['mode', '`floating` (a button and panel) or `inline` (a chat box where you put the element).', 'floating'],
  ['open', 'Present: the chat starts open.', 'Closed'],
  ['show-sources', 'Present: answers link the help articles and web pages they came from.', 'Off'],
  ['demo', 'Present: canned replies with no server, for previews.', 'Off'],
  ['details', '`ask` shows a name and email form before the first message. `off` skips the form; both modes attempt to open a ticket.', 'ask'],
  ['storage-key', 'Where the visitor’s conversation is saved, to keep two widgets apart.', 'truplexy:<endpoint>'],
  ['closed-retention-days', 'Days a conversation whose ticket the team closed stays in the browser, read-only, before it is forgotten. The visitor can only start a new chat.', '3'],
];

const cssVars = [
  ['--truplexy-accent', 'Button, header and visitor bubbles'],
  ['--truplexy-accent-ink', 'Text on the accent colour'],
  ['--truplexy-background', 'Panel background'],
  ['--truplexy-surface', 'Assistant bubbles'],
  ['--truplexy-ink', 'Text'],
  ['--truplexy-muted', 'Secondary text'],
  ['--truplexy-line', 'Borders'],
  ['--truplexy-radius', 'Panel corner radius'],
  ['--truplexy-font', 'Font family (system UI by default)'],
  ['--truplexy-width', 'Panel width (380px)'],
  ['--truplexy-height', 'Panel height (600px)'],
  ['--truplexy-offset-x', 'Distance from the side (20px)'],
  ['--truplexy-offset-y', 'Distance from the bottom (20px)'],
  ['--truplexy-z-index', 'Stacking order'],
];

const events = [
  ['truplexy:open', 'The chat opened.', 'null'],
  ['truplexy:close', 'The chat closed.', 'null'],
  ['truplexy:message', 'New replies arrived, from the assistant or your team.', '{ messages }'],
  ['truplexy:status', 'How the assistant handled the visitor’s message: answered, handoff_offered, escalated…', '{ status }'],
  ['truplexy:error', 'A message failed to send.', '{ error: { code, message, requestId } }'],
];

const serverOptions = [
  ['chatKey', 'The chat key.', 'TRUPLEXY_CHAT_KEY'],
  ['sessionSecret', 'Signs visitor sessions. Changing it starts everyone afresh.', 'TRUPLEXY_SESSION_SECRET, then the chat key'],
  ['sessionTtl', 'Seconds a visitor keeps their conversation after their last message.', '30 days'],
  ['channelId', 'Start conversations on this channel instead of the key’s.', 'The key’s channel'],
  ['allowedOrigins', 'Sites allowed to call the route from another origin, e.g. ["https://www.example.com"].', 'Same origin only'],
  ['keepTicketsOpen', 'Stop the tickets the route opens from closing on their own after a quiet spell.', 'Close per the business’s auto-close time'],
  ['authorize(request)', 'Runs first. Return false (403) or a Response to refuse: rate limits, sign-in.', 'Allow all'],
  ['context(request)', 'Background for the assistant, sent once privately when a conversation starts.', 'None'],
  ['customer(request)', 'Trusted contacts, name and metadata for a new chat; null/undefined falls back to the form.', 'None'],
  ['onError(error)', 'Server-side failures, for your logs. Never includes the key.', 'console.error'],
  ['apiBase', 'The Truplexy API.', 'TRUPLEXY_API_BASE, then production'],
];

const errors = [
  ['CUSTOMER_CONFLICT', 'The contacts belong to different customers. Correct them in Customers; no unlinked conversation is started.'],
  ['CUSTOMER_EXISTS', 'A contact race persisted after one retry. Retry the new chat.'],
  ['NOT_CONFIGURED', 'The route has no chat key, or Truplexy refused it (revoked or mistyped). Check TRUPLEXY_CHAT_KEY and redeploy.'],
  ['CHANNEL_DISABLED', 'The key’s channel is switched off. Turn it on under Integrations → Your channels.'],
  ['PLAN_LIMIT_REACHED', 'This month’s AI replies or tokens are used up. Upgrade or add tokens under Settings → Plan.'],
  ['LLM_TIMEOUT', 'The reply took too long. Give your function at least 60 seconds (maxDuration on Vercel).'],
  ['FORBIDDEN_ORIGIN', 'The widget is on a site not in allowedOrigins.'],
  ['NETWORK', 'The widget couldn’t reach endpoint: check the URL, and that the route accepts POST.'],
  ['UPSTREAM_ERROR', 'Truplexy didn’t answer. Retry; the server log has a request_id for support.'],
];

const contextExample = `import { createHandler } from "@truplexy/server";
import { getUser, rateLimit } from "./your-app";

export const POST = createHandler({
  // 20 messages a minute per visitor; refuse the rest.
  authorize: async (request) => rateLimit(request.headers.get("x-forwarded-for"), 20),

  // Who the visitor is, so the assistant can say "your order" and mean it.
  context: async (request) => {
    const user = await getUser(request);
    return user ? \`Signed in as \${user.name} (\${user.email}), \${user.plan} plan.\` : null;
  },
});`;

const jsApi = `// Any framework: open the chat from your own "Contact us" button.
import { truplexy } from "@truplexy/web"; // also exported by @truplexy/react and @truplexy/vue

truplexy.open();
truplexy.send("I need help with my order");

// Or the element itself:
const chat = document.querySelector("truplexy-chat");
chat.addEventListener("truplexy:status", (e) => {
  if (e.detail.status === "handoff_offered") analytics.track("asked_for_a_person");
});

// With the script tag, the same calls live on window.Truplexy:
Truplexy.open();`;

const labelsExample = `const chat = document.querySelector("truplexy-chat");
chat.labels = {
  title: "Soporte",
  greeting: "¡Hola! ¿En qué podemos ayudarte?",
  placeholder: "Escribe un mensaje…",
  handoff: "Hablar con una persona",
  escalated: "Una persona del equipo se ha unido y responderá aquí.",
};`;

const cssExample = `truplexy-chat {
  --truplexy-accent: #0f766e;
  --truplexy-radius: 12px;
  --truplexy-font: "Inter", sans-serif;
}

/* Deeper changes: the widget exposes parts. */
truplexy-chat::part(launcher) { box-shadow: none; }`;

const headlessReact = `import { useTruplexyChat } from "@truplexy/react";

export function SupportChat() {
  const chat = useTruplexyChat({ endpoint: "/api/truplexy", details: "off" }); // anonymous, or server-supplied identity
  return (
    <div>
      {chat.messages.map((m) => (
        <p key={m.id} className={m.role}>
          {m.agent && <b>{m.agent}: </b>}
          {m.content}
        </p>
      ))}
      {chat.sending && <p>Typing…</p>}
      {chat.offerHandoff && <button onClick={chat.handoff}>Talk to a person</button>}
      <form onSubmit={(e) => { e.preventDefault(); chat.send(e.currentTarget.text.value); e.currentTarget.reset(); }}>
        <input name="text" />
      </form>
    </div>
  );
}`;

const headlessVanilla = `import { TruplexyClient } from "@truplexy/web";

const chat = new TruplexyClient({ endpoint: "/api/truplexy" });
chat.subscribe((state) => render(state.messages, state.sending));
await chat.start();          // restores the visitor's conversation
chat.setCustomer("Ann", "ann@example.com"); // or collect these in your own form
await chat.send("Hello");    // state updates as the reply arrives
chat.setOpen(true);          // your UI is visible: clears unread, polls faster`;

const tokenFormat = `payload = "<conversation_id>.<issued_at>"      // Unix seconds
token   = base64url(payload) + "." + base64url(HMAC_SHA256(secret, payload))
secret  = TRUPLEXY_SESSION_SECRET, or the chat key`;

const toc = [
  ['how', 'How it works'],
  ['key', '1. Issue a chat key'],
  ['route', '2. Add the route'],
  ['widget', '3. Add the widget'],
  ['customers', 'Customer identity'],
  ['chat-api', 'Server chat API'],
  ['pictures', 'Pictures'],
  ['customise', 'Customise'],
  ['api', 'JavaScript API'],
  ['headless', 'Build your own UI'],
  ['server', 'Server options'],
  ['security', 'Security'],
  ['protocol', 'Protocol'],
  ['troubleshooting', 'Troubleshooting'],
];

/** `code` spans inside table text. */
const inline = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/`([^`]+)`/g, '<code>$1</code>');
---
<Docs
  title="Website chat SDK — Truplexy"
  breadcrumbs={[{ name: 'Docs', path: '/docs' }, { name: 'Website chat SDK', path: '/docs/web-sdk' }]}
  description="Add Truplexy's AI support chat to any website in minutes: React, Next.js, Vue, Nuxt, Svelte, Angular, Astro, WordPress or plain HTML. Your chat key stays on your server."
  eyebrow="Developers"
  heading="Add Truplexy chat to any website"
  lede="A ready-made chat widget, one small route on your server, and you’re live. It works with React, Next.js, Vue, Nuxt, Svelte, Angular, Astro, WordPress and plain HTML. Your chat key never reaches the browser."
  toc={toc}
>
  <Fragment slot="hero-actions">
    <Button href={`${SITE.dashboardUrl}/`}>Get a chat key</Button>
    <button type="button" class="btn btn-md btn-ghost" data-demo-open>
      <span class="btn-roll"><span class="btn-text">Try the demo chat</span></span>
    </button>
  </Fragment>

          <h2 id="how">How it works</h2>
          <Flow
            description="The widget on your site talks to a route on your server, which calls Truplexy with your chat key. Team replies come back to the widget live."
            nodes={[
              { label: 'Your site', title: 'The widget', text: 'Chat button, messages, handoff. No keys.' },
              { label: 'Your server', title: 'One route', text: 'Holds the chat key. Signs each visitor’s session.' },
              { label: 'Truplexy', title: 'The assistant', text: 'Answers, tickets, handoff to your team.' },
            ]}
          />
          <p>
            Visitors keep their conversation when they reload or come back, without accounts or a database: your route gives each one a signed session. When your team
            replies from Tickets, the reply appears in the widget live.
          </p>

          <h2 id="key">1. Issue a chat key</h2>
          <ol>
            <li>In the <a href={SITE.dashboardUrl}>dashboard</a>, open <strong>Integrations → Add a channel → Website chat</strong>.</li>
            <li>Add a <strong>Website</strong> channel, so tickets show they came from your site, and issue its chat key.</li>
            <li>Store it on your server as <code>TRUPLEXY_CHAT_KEY</code>, in <code>.env</code> or your host’s settings. Never put it in front-end code.</li>
          </ol>

          <h2 id="route">2. Add the route to your server</h2>
          <p>The widget talks only to this route. It’s one line for most frameworks.</p>
          <CodeTabs group="server" label="Your server" tabs={serverTabs} />

          <h2 id="widget">3. Add the widget to your site</h2>
          <p>Point <code>endpoint</code> at your route. Then reload: the chat button appears bottom right.</p>
          <CodeTabs group="widget" label="Your site" tabs={WIDGET_RECIPES} />

          <h2 id="customers">Customer identity</h2>
          <p>The default widget form collects a self-reported name and email. Your route records the customer before starting the conversation; its ticket inherits the customer and channel. An identified chat stops if linking fails. Anonymous chat remains available with <code>details="off"</code> and no server identity.</p>
          <ul>{CUSTOMER_RULES.map(rule => <li>{rule}</li>)}</ul>
          <p>For signed-in users, supply trusted contacts and metadata through <code>customer(request)</code>, then set <code>details="off"</code> on the widget. A non-null resolver result replaces browser details; null or undefined falls back to the form. Only new conversations run the resolver.</p>
          <CodeBlock name={CUSTOMER_RECIPE.name} code={CUSTOMER_RECIPE.code} />
          <p>Python and PHP routes expose <code>resolve_customer</code>; Go exposes <code>resolveCustomer</code>; WordPress has the <code>truplexy_chat_customer</code> filter. Set <code>TRUPLEXY_CHANNEL_ID</code> on these routes (a constant in WordPress) to override the key’s channel. Node uses <code>channelId</code>.</p>
          <p>In a headless UI, <code>send()</code> sets <code>needsDetails</code> when details are missing. Keep the draft, call <code>setCustomer(name, email)</code>, then send it again. Use <code>cancelDetails()</code> to dismiss the form. State also includes <code>customer</code>, <code>profile</code> and <code>ticket</code>.</p>
          <p><code>reset()</code> retains customer details. On account changes, dispose of the old client and recreate it with separate storage per identity, or clear its store first. The server must enforce authorization. Identifying a customer does not grant access to earlier conversations, and existing conversations are not relinked.</p>

          <h2 id="chat-api">Server chat API</h2>
          <p>Import <code>createChatClient</code> from <code>@truplexy/server</code> on your server. It reads <code>TRUPLEXY_CHAT_KEY</code> and calls the production <code>/v3</code> API; options are <code>chatKey</code>, <code>apiBase</code>, and <code>fetch</code>. Responses retain the API’s snake_case fields. Staff customer management under <code>/customers</code> is separate.</p>
          <CodeBlock name="chat.ts" code={`import { createChatClient } from "@truplexy/server";
const chat = createChatClient();
const customer = await chat.upsertCustomer({ contacts: [{ type: "app", value: "user-42" }] });
const conversation = await chat.createConversation({ customer_id: customer.id });
const result = await chat.sendMessage(conversation.id, "Hello");`} />
          <div class="table-wrap"><table><thead><tr><th>Method</th><th>Endpoint</th><th>Behavior</th></tr></thead><tbody>
            {CHAT_API_ENDPOINTS.map(([method, path, sdk, description]) => <tr><td><code>{sdk}</code></td><td><code>{method} {path}</code></td><td>{description}</td></tr>)}
          </tbody></table></div>
          <p>A channel-bound key supplies the channel automatically; <code>channel_id</code> can override it. Disabled channels return <code>CHANNEL_DISABLED</code>. <code>TruplexyApiError</code> exposes <code>status</code>, <code>code</code>, <code>requestId</code>, <code>details</code> and <code>retryAfter</code>. Keep its raw message on the server; the widget handler returns fixed visitor-safe messages.</p>
          <p>Show <code>reply</code> for answered, clarification, and no-answer statuses. Offer a handoff button for <code>handoff_offered</code>. Handoff notifies the team while the AI continues; escalation silences the AI. Resume leaves the ticket open; closure ends escalation and clears handoff. <code>escalated</code> and <code>context</code> replies are null.</p>
          <p>Agent replies take <code>content</code> (1–8000 characters), optional <code>author</code> (up to 64), <code>external_id</code> (up to 128), and <code>escalate</code> (default false). Reuse the platform message ID to deduplicate retries. New replies return 201; repeated IDs return 200.</p>
          <p>Realtime includes messages and ticket changes; pass only the visitor’s conversation topic to their browser. Webhooks report staff actions, exclude internal notes and integration actions, and do not echo resume or agent replies sent through the integration. Verify the raw-body signature, acknowledge within 2.5 seconds and deduplicate the delivery ID across its possible retry.</p>
          <p>Migration: the five widget protocol actions and signed-session format remain compatible. Customer linking errors now stop new identified chats. Background context and automatic ticket creation remain best effort. Only <code>REALTIME_NOT_CONFIGURED</code> triggers polling fallback.</p>

          <h2 id="pictures">Pictures</h2>
          <p>The assistant can read pictures a customer attaches, on plans that include image input. The ready-made widget has no attach button yet, so this is for a chat UI you build yourself.</p>
          <p>A browser never holds your chat key, so it never calls the picture endpoints. Your route registers each picture (<code>POST /conversations/{'{id}'}/attachments</code>, with only the filename, type, size and SHA-256 the browser sends you) and passes the returned <code>url</code> and <code>headers</code> back. The browser then <code>PUT</code>s the file straight to that <code>url</code> with exactly those headers and no cookies or <code>Authorization</code>. Your route finally sends the message with the picture IDs in <code>attachments</code>. Protect the registration route like the message route: sign-in or rate limits.</p>
          <p>A browser’s <code>PUT</code> needs the storage bucket’s CORS rule to allow <code>PUT</code> and <code>Content-Type</code> from your site’s origin. The calls, limits and errors are in the <a href="/docs/api#pictures">chat API guide</a>.</p>

          <h2 id="customise">Customise</h2>
          <h3>Attributes</h3>
          <p>Set them on <code>&lt;truplexy-chat&gt;</code>, as <code>data-*</code> on the script tag (<code>data-show-sources</code>), or as props in React and Vue (<code>showSources</code>).</p>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Attribute</th><th>What it does</th><th>Default</th></tr></thead>
              <tbody>
                {attributes.map(([name, what, def]) => (
                  <tr><td><code>{name}</code></td><td set:html={inline(what)} /><td class="faint">{def}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <h3>Colours and size</h3>
          <div class="table-wrap">
            <table>
              <thead><tr><th>CSS variable</th><th>Controls</th></tr></thead>
              <tbody>
                {cssVars.map(([name, what]) => <tr><td><code>{name}</code></td><td>{what}</td></tr>)}
              </tbody>
            </table>
          </div>
          <CodeBlock name="styles.css" code={cssExample} />
          <h3>Other languages</h3>
          <p>Every string can be replaced through the <code>labels</code> property, or the <code>labels</code> prop in React and Vue. That includes <code>poweredBy</code>, the small “Powered by Truplexy” link under the message box.</p>
          <CodeBlock name="labels.js" code={labelsExample} />

          <h2 id="api">JavaScript API</h2>
          <p>The element has <code>open()</code>, <code>close()</code>, <code>toggle()</code>, <code>send(text)</code> and <code>reset()</code>, and fires events that bubble to <code>document</code>.</p>
          <CodeBlock name="app.js" code={jsApi} />
          <div class="table-wrap">
            <table>
              <thead><tr><th>Event</th><th>When</th><th><code>detail</code></th></tr></thead>
              <tbody>
                {events.map(([name, when, detail]) => <tr><td><code>{name}</code></td><td>{when}</td><td><code>{detail}</code></td></tr>)}
              </tbody>
            </table>
          </div>
          <p>In React, pass <code>onMessage</code>, <code>onStatus</code>, <code>onError</code>, <code>onOpen</code> and <code>onClose</code>. In Vue, listen with <code>@message</code>, <code>@status</code> and so on.</p>

          <h2 id="headless">Build your own UI</h2>
          <p>Prefer your own design? The same client runs without the widget: sessions, handoff and live team replies included.</p>
          <CodeBlock name="SupportChat.tsx" code={headlessReact} />
          <CodeBlock name="chat.js" code={headlessVanilla} />
          <p class="faint">Vue has the same thing as <code>useTruplexyChat()</code> from <code>@truplexy/vue</code>.</p>

          <h2 id="server">Server options</h2>
          <p><code>createHandler(options)</code> returns a standard <code>(request: Request) =&gt; Response</code> handler. <code>createNodeHandler(options)</code> from <code>@truplexy/server/node</code> wraps it for Express-style servers.</p>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Option</th><th>What it does</th><th>Default</th></tr></thead>
              <tbody>
                {serverOptions.map(([name, what, def]) => <tr><td><code>{name}</code></td><td>{what}</td><td class="faint">{def}</td></tr>)}
              </tbody>
            </table>
          </div>
          <CodeBlock name="app/api/truplexy/route.ts" code={contextExample} />

          <h2 id="security">Security</h2>
          <ul>
            <li><strong>The key stays on your server.</strong> The browser only ever sees your route and its own signed session.</li>
            <li><strong>Visitors can’t read each other’s chats.</strong> A session names one conversation and is signed; a changed or expired one starts a new conversation.</li>
            <li><strong>Background stays private.</strong> <code>context</code> messages are never shown to the visitor, and visitors can’t write their own.</li>
            <li><strong>Rate-limit the route</strong> as you would a contact form. Every message uses AI replies from your plan.</li>
            <li><strong>Different origin?</strong> If the widget and the route are on different domains, list the site in <code>allowedOrigins</code>.</li>
          </ul>

          <h2 id="protocol">Protocol</h2>
          <p>For a route in a language without an SDK: one <code>POST</code> endpoint taking JSON <code>{'{'}action, session?, text?, customer?{'}'}</code>. Your server calls the Truplexy chat API with the chat key.</p>
          <div class="table-wrap">
            <table>
              <thead><tr><th>action</th><th>Calls</th><th>Returns</th></tr></thead>
              <tbody>
                <tr><td><code>message</code></td><td><code>PUT /customer</code> and <code>POST /conversations</code> when there’s no valid session, then <code>POST /conversations/:id/ticket</code> for that new conversation, then <code>POST /conversations/:id/messages</code></td><td><code>{'{session, message, reply, status, sources, ticket?}'}</code></td></tr>
                <tr><td><code>history</code></td><td><code>GET /conversations/:id</code></td><td><code>{'{session, conversation}'}</code>, or <code>{'{session: null}'}</code></td></tr>
                <tr><td><code>handoff</code></td><td><code>POST /conversations/:id/handoff</code></td><td><code>{'{session, conversation}'}</code></td></tr>
                <tr><td><code>profile</code></td><td><code>GET /profile</code></td><td><code>{'{business: {name, logo_url}, bot: {id, name, avatar_url}, widget?: {…}}'}</code></td></tr>
                <tr><td><code>live</code></td><td><code>POST /realtime/token</code></td><td><code>{'{url, publishable_key, conversation_topic}'}</code>, or <code>{'{}'}</code></td></tr>
              </tbody>
            </table>
          </div>
          <CodeBlock name="session token" lang="txt" code={tokenFormat} />
          <ul>
            <li>Trim <code>text</code>; refuse it when empty, over 4000 characters, or starting with <code>[Context only</code>.</li>
            <li>With <code>customer: {'{name, email}'}</code>, refuse a missing name, one over 120 characters, or an invalid email. For a new conversation, resolve trusted identity first or convert the form to <code>{'{name, contacts: [{type: "email", value}]}'}</code>. Call <code>PUT /customer</code> and start the conversation with its <code>customer_id</code>. Retry <code>CUSTOMER_EXISTS</code> once; other linking failures stop creation. Background context and automatic ticket creation remain best effort. Pass on only the ticket’s <code>id, subject, status</code>.</li>
            <li>In <code>profile</code>, pass on only the names, the pictures and the <code>widget</code> object, field by field. The widget shows them and falls back to its defaults if the call fails. <code>widget</code> is how you set the look once in the Truplexy dashboard (Integrations → Chat widget) for every site: any attribute you set on the element still wins over it.</li>
            <li>Never pass on <code>bot_topic</code>: it carries every customer’s messages. <code>conversation_topic</code> is safe for the browser.</li>
            <li>In <code>history</code> and <code>handoff</code>, drop user messages starting with <code>[Context only</code>, and pass on only <code>id, role, content, author, agent, created_at</code>.</li>
            <li>Errors are <code>{'{error: {code, message, request_id}}'}</code> with a message you write. Never forward the API’s own message.</li>
          </ul>

          <h2 id="troubleshooting">Troubleshooting</h2>
          <p>The widget shows a short message; the error’s <code>code</code> is in the <code>truplexy:error</code> event and in your server’s log.</p>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Code</th><th>Fix</th></tr></thead>
              <tbody>
                {errors.map(([code, fix]) => <tr><td><code>{code}</code></td><td>{fix}</td></tr>)}
              </tbody>
            </table>
          </div>
          <p>Still stuck? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> with the <code>request_id</code>.</p>
