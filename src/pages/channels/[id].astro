---
import Docs from '../../layouts/Docs.astro';
import Button from '../../components/ui/Button.astro';
import ChannelIcon from '../../components/ui/ChannelIcon';
import Flow from '../../components/docs/Flow.astro';
import ChannelDemo from '../../components/channels/ChannelDemo.astro';
import { SITE } from '../../data/site';
import { GROUP_LABEL, channel } from '../../data/channels';
import { OVERVIEW_IDS, PAGES, type OverviewId } from '../../data/channel-pages';
import { availability, docsHref } from '../../data/setup-guides';

export function getStaticPaths() {
  return OVERVIEW_IDS.map((id) => ({ params: { id } }));
}

const id = Astro.params.id as OverviewId;
const ch = channel(id);
const page = PAGES[id];
const plan = availability(page.planLabel);
const live = ch.status === 'live';
const guide = docsHref(id);

const toc: [string, string][] = [
  ['demo', 'See it in action'],
  ['what', 'What it does'],
  ['how', 'How it works'],
  ['glance', 'At a glance'],
];
if (page.faq.length) toc.push(['faq', 'Questions']);
toc.push(['related', 'Works well with']);

const glance: [string, string][] = [
  ['Available on', plan.detail ? `${plan.text} (${plan.detail})` : plan.text],
  ['Customers recognised by', page.recognisedBy],
  ['Your team replies from', page.teamRepliesFrom],
  ['Setting it up', page.setup],
];
---

<Docs
  title={`${ch.name} — Truplexy`}
  description={page.summary}
  breadcrumbs={[{ name: 'Channels', path: '/channels' }, { name: ch.name, path: `/channels/${id}` }]}
  eyebrow={GROUP_LABEL[ch.group]}
  heading={ch.name}
  lede={page.summary}
  toc={toc}
>
  <Fragment slot="hero-top">
    <div class="mb-5 flex items-center gap-3">
      <span class="grid h-12 w-12 place-items-center rounded-2xl border border-line bg-surface shadow-sm" aria-hidden="true">
        <ChannelIcon id={id} size={24} />
      </span>
      {live
        ? <span class="chip"><span class="live-dot" aria-hidden="true"></span>Live now</span>
        : <span class="soon-tag">Coming soon</span>}
    </div>
  </Fragment>
  <Fragment slot="hero-actions">
    <Button href={SITE.signupUrl}>Start free</Button>
    <Button href={guide} variant="ghost" arrow={false}>Set up {ch.name}</Button>
  </Fragment>

  <h2 id="demo">See it in action</h2>
  <ChannelDemo id={id} context={page.demo.context} lines={page.demo.lines} />

  <h2 id="what">What it does</h2>
  <ul>
    {page.capabilities.map((c) => <li>{c}</li>)}
  </ul>

  <h2 id="how">How it works</h2>
  <Flow nodes={page.journey} description={page.journeyLabel} />

  <h2 id="glance">At a glance</h2>
  <div class="table-wrap glance">
    <table>
      <tbody>
        {glance.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
      </tbody>
    </table>
  </div>
  <p>The <a href={guide}>setup guide</a> has every step, and <a href="/pricing">pricing</a> has the limits on each plan.</p>

  {page.faq.length > 0 && (
    <Fragment>
      <h2 id="faq">Questions</h2>
      {page.faq.map(([q, a]) => (
        <Fragment>
          <h3>{q}</h3>
          <p>{a}</p>
        </Fragment>
      ))}
    </Fragment>
  )}

  <h2 id="related">Works well with</h2>
  <ul class="cards">
    {page.related.map((r) => (
      <li>
        <a href={`/channels/${r}`} class="card-link">
          <span class="icon"><ChannelIcon id={r} size={18} /></span>
          <span>
            <span class="name">{channel(r).name} {channel(r).status === 'soon' && <span class="soon-tag">Coming soon</span>}</span>
            <span class="blurb">{PAGES[r].blurb}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
  <p><a href="/channels">See all channels →</a></p>
</Docs>
