---
import Docs from '../../layouts/Docs.astro';
import Button from '../../components/ui/Button.astro';
import ChannelIcon from '../../components/ui/ChannelIcon';
import { SITE } from '../../data/site';
import { GROUP_LABEL, channelsIn, type ChannelGroup } from '../../data/channels';
import { OVERVIEW_IDS, PAGES, type OverviewId } from '../../data/channel-pages';

const has = (id: string): id is OverviewId => (OVERVIEW_IDS as string[]).includes(id);
const groups = (Object.keys(GROUP_LABEL) as ChannelGroup[]).filter((g) => channelsIn(g).some((c) => has(c.id)));
const toc = [...groups.map((g) => [g, GROUP_LABEL[g]] as const), ['build', 'Build your own'] as const];
---

<Docs
  title="Channels — Truplexy"
  description="Every channel Truplexy answers customers on: website chat, Telegram, Discord, WhatsApp, Messenger, Instagram, email, Shopify, WooCommerce, WordPress, HubSpot, Zendesk, and Slack and Microsoft Teams for your team."
  breadcrumbs={[{ name: 'Channels', path: '/channels' }]}
  eyebrow="Channels & platforms"
  heading="Meet customers where they already are"
  lede={`${OVERVIEW_IDS.length} channels and platforms, one conversation. Pick one to see what Truplexy does there and how a conversation runs.`}
  toc={toc}
>
  <Fragment slot="hero-actions">
    <Button href={SITE.signupUrl}>Start free trial</Button>
    <Button href="/docs" variant="ghost" arrow={false}>Setup guides</Button>
  </Fragment>

  {groups.map((g) => (
    <>
      <h2 id={g}>{GROUP_LABEL[g]}</h2>
      <ul class="cards">
        {channelsIn(g).filter((c) => has(c.id)).map((c) => (
          <li>
            <a href={`/channels/${c.id}`} class="card-link">
              <span class="icon"><ChannelIcon id={c.id} size={18} /></span>
              <span>
                <span class="name">{c.name} {c.status === 'soon' && <span class="soon-tag">Coming soon</span>}</span>
                <span class="blurb">{PAGES[c.id as OverviewId].blurb}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </>
  ))}

  <h2 id="build">Build your own</h2>
  <p>
    Somewhere else your customers write? Connect it yourself with the <a href="/docs/api">REST API</a>, and use <a href="/docs/webhooks">webhooks</a> to deliver your
    team’s replies. It gets the same memory, tickets and handoff as every channel above.
  </p>
</Docs>
