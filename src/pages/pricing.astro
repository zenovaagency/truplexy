---
import Base from '../layouts/Base.astro';
import Nav from '../components/chrome/Nav.astro';
import Footer from '../components/chrome/Footer.astro';
import FinalCta from '../components/home/FinalCta.astro';
import PlanCards from '../components/pricing/PlanCards.astro';
import CompareTable from '../components/pricing/CompareTable.astro';
import { COMPARISON, PLANS } from '../data/pricing';
import { SITE } from '../data/site';

// The add-on prices come straight from the table, so the two can't drift.
const addOns = COMPARISON.find((s) => s.group === 'Token add-ons')!.rows;
const [extra, max] = addOns;
const offered = PLANS.filter((p) => typeof max.values[p.id] === 'string');
---

<Base
  title="Pricing — Truplexy"
  description="Truplexy plans: Free, Starter at $29 a month and Pro at $79 a month. Compare AI tokens, conversations, channels, integrations and support across every plan."
>
  <Nav />
  <main id="main" class="relative overflow-x-clip">
    <section class="relative pb-[var(--section-y)] pt-[calc(var(--nav-h)+clamp(3rem,6vw,5.5rem))]" aria-labelledby="pricing-title">
      <div class="aurora" aria-hidden="true"></div>
      <div class="container-t relative">
        <div class="mx-auto max-w-[760px] text-center">
          <p class="eyebrow" data-reveal>Pricing</p>
          <h1 id="pricing-title" class="display mt-5 text-balance text-[clamp(2.3rem,1.5rem+3vw,3.75rem)]" data-split>
            Simple plans for every conversation.
          </h1>
          <p class="lede mx-auto mt-6 max-w-[600px] text-pretty" data-reveal>
            Start free on one channel. Upgrade for more AI tokens, more channels and the integrations your team
            already uses.
          </p>
        </div>

        <PlanCards compareLink={false} />
      </div>
    </section>

    <section id="compare" class="section scroll-mt-[var(--nav-h)] border-y border-line bg-surface" aria-labelledby="compare-title">
      <div class="container-t">
        <!-- Stacks over the table's header, which reaches up under it. -->
        <div class="relative z-[4] mx-auto max-w-[760px] text-center">
          <h2 id="compare-title" class="h2" data-split>Compare every plan</h2>
          <p class="lede mx-auto mt-4 max-w-[560px]" data-reveal>Limits, channels and integrations, side by side.</p>
        </div>

        <div class="mt-12">
          <CompareTable />
        </div>

        <div class="card mt-14 grid gap-6 !bg-paper p-6 sm:p-8 md:grid-cols-[1.2fr_1fr] md:items-center" data-reveal>
          <div>
            <h2 class="text-xl font-bold tracking-tight">Need more AI tokens?</h2>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-muted">
              Paid plans can add tokens each month without moving up a plan. Add-ons aren’t available on Free.
            </p>
          </div>
          <ul class="grid gap-3 sm:grid-cols-2">
            {offered.map((plan) => (
              <li class="rounded-xl border border-line bg-surface p-4">
                <p class="mono text-ink-faint">{plan.name}</p>
                <p class="mt-2 text-[1.35rem] font-bold tracking-tight tabular-nums">{extra.values[plan.id]}</p>
                <p class="mt-1 text-[0.85rem] text-ink-muted">Up to {max.values[plan.id]}</p>
              </li>
            ))}
          </ul>
        </div>

        <p class="mt-8 text-center text-[0.9rem] text-ink-faint" data-reveal>
          Not sure which plan fits? <a href={SITE.demoUrl} class="font-semibold text-accent hover:underline">Book a demo</a> and we’ll walk you through it.
        </p>
      </div>
    </section>

    <FinalCta />
  </main>
  <Footer />
</Base>
