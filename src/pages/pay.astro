---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import { SITE } from '../data/site';

/**
 * Paddle's default payment link, shown as an inline checkout. Paddle sends
 * customers here with `?_ptxn=txn_…`, and the API's transactions point at it.
 * Paddle.js sees `_ptxn` on its own and opens that transaction in the frame
 * below (the element with class `checkout-container`), using the inline settings
 * passed to `Initialize`.
 * Paddle also requires the page to load Paddle.js and to sit on an approved
 * domain (Paddle > Checkout > Checkout settings and Website approval).
 *
 * Inline checkout only renders the frame (email, country, payment details).
 * The page has to show what is being bought and the totals, so the summary
 * beside the frame is filled from Paddle.js's checkout events.
 *
 * The dashboard sends customers here to pay (it cannot open checkouts itself:
 * it is a sign-in-only app on a domain Paddle has not approved). When they
 * finish, Paddle returns them to the billing page. That address is fixed here,
 * never taken from the URL, so this page cannot be used as an open redirect.
 *
 * The client-side token is public by design. It is read at build time, so
 * changing it takes a new deploy.
 */
const token = import.meta.env.VITE_PADDLE_CLIENT_TOKEN ?? process.env.VITE_PADDLE_CLIENT_TOKEN ?? '';
const environment = (import.meta.env.VITE_PADDLE_ENV ?? process.env.VITE_PADDLE_ENV) === 'production' ? 'production' : 'sandbox';
const billingUrl = new URL('/settings/plan', SITE.dashboardUrl).href;
const successUrl = `${billingUrl}?paid=1`;
---

<Base title="Checkout — Truplexy" noindex>
  <main id="main" class="relative overflow-hidden bg-ground-cream">
    <section class="container-t pay relative py-16 md:py-24">
      <header class="pay-head">
        <p class="eyebrow">Secure checkout</p>
        <h1 id="pay-title" class="display mt-4 text-balance text-[clamp(1.75rem,1.3rem+2vw,2.75rem)]">
          Opening your checkout…
        </h1>
        <p id="pay-note" class="lede mt-4 max-w-[520px] text-pretty" aria-live="polite">
          Payments are handled by Paddle, our merchant of record. If nothing opens, allow scripts from paddle.com and reload.
        </p>
      </header>

      <div class="pay-grid mt-10">
        <aside class="pay-summary" aria-labelledby="pay-summary-title" hidden>
          <h2 id="pay-summary-title" class="pay-summary-title">Order summary</h2>
          <ul id="pay-items" class="pay-items"></ul>
          <div id="pay-trial" class="pay-trial" hidden>
            <p id="pay-trial-title" class="pay-trial-title"></p>
            <p id="pay-trial-text" class="pay-trial-text"></p>
          </div>

          <h3 class="pay-section">Due today</h3>
          <dl class="pay-totals">
            <div class="pay-row" id="pay-row-discount" hidden>
              <dt>Discount</dt>
              <dd id="pay-discount"></dd>
            </div>
            <div class="pay-row">
              <dt>Subtotal</dt>
              <dd id="pay-subtotal"></dd>
            </div>
            <div class="pay-row">
              <dt>Tax</dt>
              <dd id="pay-tax"></dd>
            </div>
            <div class="pay-row pay-row-total">
              <dt>Total due today</dt>
              <dd id="pay-total"></dd>
            </div>
          </dl>

          <div id="pay-then" class="pay-then" hidden>
            <h3 id="pay-then-title" class="pay-section"></h3>
            <dl class="pay-totals">
              <div class="pay-row">
                <dt>Subtotal</dt>
                <dd id="pay-then-subtotal"></dd>
              </div>
              <div class="pay-row">
                <dt>Tax</dt>
                <dd id="pay-then-tax"></dd>
              </div>
              <div class="pay-row pay-row-total">
                <dt id="pay-then-label">Total</dt>
                <dd id="pay-then-total"></dd>
              </div>
            </dl>
          </div>

          <p class="pay-fine">
            Tax is calculated from your country. Cancel any time from your billing page. See our <a href="/refunds">refund policy</a>.
          </p>
        </aside>

        <div class="pay-frame-wrap">
          <!-- Paddle.js mounts the checkout frame into this element. -->
          <div id="checkout-frame" class="checkout-container"></div>
        </div>
      </div>

      <div class="mt-10">
        <Button href={billingUrl} variant="ghost" arrow={false}>Back to billing</Button>
      </div>
    </section>
  </main>

  <script is:inline src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
  <script is:inline define:vars={{ token, environment, successUrl }}>
    (function () {
      var title = document.getElementById('pay-title');
      var note = document.getElementById('pay-note');
      var summary = document.querySelector('.pay-summary');
      var grid = document.querySelector('.pay-grid');

      function fail(heading, text) {
        title.textContent = heading;
        note.textContent = text;
        grid.hidden = true;
      }

      var txn = new URLSearchParams(location.search).get('_ptxn');
      if (!txn) {
        fail('No checkout to open', 'Start from the billing page in your dashboard, and choose a plan.');
        return;
      }
      if (!token) {
        fail('Checkout is not available', 'Payments are not configured on this site yet. Please try again later.');
        return;
      }
      if (!window.Paddle) {
        fail('Checkout could not load', 'Paddle’s script was blocked. Allow scripts from paddle.com and reload this page.');
        return;
      }

      var currency = 'USD';
      function money(n) {
        try {
          return new Intl.NumberFormat(undefined, { style: 'currency', currency: currency }).format(Number(n) || 0);
        } catch (e) {
          return (Number(n) || 0).toFixed(2) + ' ' + currency;
        }
      }
      function setText(id, text) {
        document.getElementById(id).textContent = text;
      }
      function unit(interval, count) {
        return count === 1 ? interval : interval + 's';
      }
      // "month" or "3 months", for "every …".
      function every(c) {
        if (!c) return '';
        return c.frequency === 1 ? c.interval : c.frequency + ' ' + unit(c.interval, c.frequency);
      }
      // "/ month" or "/ 3 months", for after a price.
      function per(c) {
        return c ? '/ ' + every(c) : '';
      }
      // The date a trial that starts today ends, which is when the first payment is taken.
      function trialEnd(t) {
        var d = new Date();
        var n = Number(t.frequency) || 0;
        if (t.interval === 'week') d.setDate(d.getDate() + 7 * n);
        else if (t.interval === 'month') d.setMonth(d.getMonth() + n);
        else if (t.interval === 'year') d.setFullYear(d.getFullYear() + n);
        else d.setDate(d.getDate() + n);
        try {
          return new Intl.DateTimeFormat(undefined, { dateStyle: 'long' }).format(d);
        } catch (e) {
          return d.toDateString();
        }
      }
      function span(className, text) {
        var s = document.createElement('span');
        s.className = className;
        s.textContent = text;
        return s;
      }

      // Fills the summary beside the frame. Paddle sends fresh totals on load and whenever the
      // customer's country or postal code changes the tax.
      function render(data) {
        if (!data) return;
        currency = data.currency_code || currency;
        var items = data.items || [];
        var list = document.getElementById('pay-items');
        list.textContent = '';
        var trial = null;
        var billing = null;
        items.forEach(function (it) {
          // What the customer pays each period, tax included. During a trial the item's totals
          // are all zero and the real price is in recurring_totals.
          var each = it.recurring_totals || it.totals || {};
          var product = it.product && it.product.name ? it.product.name : '';
          var li = document.createElement('li');
          li.className = 'pay-item';
          var left = document.createElement('span');
          left.className = 'pay-item-text';
          left.appendChild(span('pay-item-name', product || it.price_name || 'Truplexy'));
          var bits = [];
          if (it.price_name && it.price_name !== product) bits.push(it.price_name + ' plan');
          if (it.quantity > 1) bits.push('× ' + it.quantity);
          if (bits.length) left.appendChild(span('pay-item-detail', bits.join(' · ')));
          var right = document.createElement('span');
          right.className = 'pay-item-price';
          right.appendChild(span('pay-item-amount', money(each.total)));
          if (it.billing_cycle) right.appendChild(span('pay-item-per', per(it.billing_cycle)));
          li.appendChild(left);
          li.appendChild(right);
          list.appendChild(li);
          if (it.trial_period && !trial) trial = it.trial_period;
          if (it.billing_cycle && !billing) billing = it.billing_cycle;
        });

        var totals = data.totals || {};
        var discount = Number(totals.discount) || 0;
        document.getElementById('pay-row-discount').hidden = discount <= 0;
        if (discount > 0) setText('pay-discount', '−' + money(discount));
        setText('pay-subtotal', money(totals.subtotal));
        setText('pay-tax', money(totals.tax));
        setText('pay-total', money(totals.total));

        var firstPayment = trial ? trialEnd(trial) : '';
        var trialEl = document.getElementById('pay-trial');
        if (trial) {
          trialEl.hidden = false;
          // "7-day", not "7-days": a compound adjective stays singular.
          setText('pay-trial-title', trial.frequency + '-' + trial.interval + ' free trial');
          setText('pay-trial-text', 'Nothing is charged today. Your first payment is on ' + firstPayment + '. Cancel before then and you pay nothing.');
        } else {
          trialEl.hidden = true;
        }

        // What the plan costs once it is running: after the trial, or on each renewal.
        var thenEl = document.getElementById('pay-then');
        var rt = data.recurring_totals;
        if (rt && billing) {
          thenEl.hidden = false;
          setText('pay-then-title', trial ? 'After your trial · from ' + firstPayment : 'Then, every ' + every(billing));
          setText('pay-then-subtotal', money(rt.subtotal));
          setText('pay-then-tax', money(rt.tax));
          setText('pay-then-label', 'Total every ' + every(billing));
          setText('pay-then-total', money(rt.total));
        } else {
          thenEl.hidden = true;
        }
        summary.hidden = false;
      }

      if (environment === 'sandbox') window.Paddle.Environment.set('sandbox');
      window.Paddle.Initialize({
        token: token,
        checkout: {
          settings: {
            // Paddle.js opens the `_ptxn` transaction itself, with these settings.
            displayMode: 'inline',
            variant: 'one-page',
            theme: 'light',
            // A CLASS name, without a dot: Paddle.js runs getElementsByClassName() on it. An id
            // matches nothing and the frame crashes with "reading 'appendChild' of undefined".
            frameTarget: 'checkout-container',
            frameInitialHeight: 520,
            frameStyle: 'width: 100%; min-width: 312px; background-color: transparent; border: none;',
            // Paddle sends the customer back to the billing page when they finish.
            successUrl: successUrl,
          },
        },
        eventCallback: function (e) {
          if (!e || !e.name) return;
          if (e.name === 'checkout.loaded') {
            title.textContent = 'Complete your purchase';
            note.textContent = 'Enter your details below. Payments are handled by Paddle, our merchant of record.';
            render(e.data);
          } else if (e.name === 'checkout.items.updated' || e.name === 'checkout.customer.updated' || e.name === 'checkout.discount.applied' || e.name === 'checkout.discount.removed') {
            render(e.data);
          } else if (e.name === 'checkout.completed') {
            title.textContent = 'Thank you';
            note.textContent = 'Your payment went through. Taking you back to billing…';
            // Paddle redirects by itself; this only covers a redirect that doesn't happen.
            setTimeout(function () { location.assign(successUrl); }, 4000);
          } else if (e.name === 'checkout.error' || e.name === 'checkout.failed') {
            title.textContent = 'Checkout ran into a problem';
            note.textContent = 'Nothing was charged. Reload to try again, or start again from the billing page.';
          }
        },
      });
    })();
  </script>

  <!-- Global on purpose: the summary rows are built by the script above, and Astro's scoped
       styles only match elements it rendered itself, so scoped rules never reached them. -->
  <style is:global>
    .pay-head {
      max-width: 640px;
    }
    .pay-grid {
      display: grid;
      gap: 24px;
      align-items: start;
    }
    @media (min-width: 900px) {
      .pay-grid {
        grid-template-columns: minmax(300px, 400px) minmax(0, 1fr);
        gap: 40px;
      }
      .pay-summary {
        position: sticky;
        top: 96px;
      }
    }
    .pay-grid[hidden],
    .pay-summary[hidden] {
      display: none;
    }
    /* Keep the layout stable while the summary waits for its first totals. */
    .pay-frame-wrap {
      grid-column: 1 / -1;
    }
    @media (min-width: 900px) {
      .pay-frame-wrap {
        grid-column: 2;
        grid-row: 1;
      }
    }
    .pay-frame-wrap,
    .pay-summary {
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-lg);
      box-shadow: 0 1px 2px rgb(14 18 34 / 0.04), 0 24px 48px -28px rgb(35 56 230 / 0.28);
    }
    .pay-frame-wrap {
      padding: clamp(12px, 2.5vw, 24px);
      min-height: 200px;
    }
    .checkout-container {
      width: 100%;
    }
    .pay-summary {
      padding: 24px;
      text-align: left;
      color: var(--color-ink);
    }
    .pay-summary-title {
      font-size: 0.8125rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--color-ink-faint);
    }
    .pay-items {
      list-style: none;
      margin: 16px 0 0;
      padding: 0 0 16px;
      border-bottom: 1px solid var(--color-line);
      display: grid;
      gap: 14px;
    }
    .pay-item {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
    }
    .pay-item-text {
      display: grid;
      gap: 2px;
      min-width: 0;
    }
    .pay-item-name {
      font-weight: 600;
      color: var(--color-ink);
    }
    .pay-item-detail {
      font-size: 0.875rem;
      color: var(--color-ink-muted);
    }
    .pay-item-price {
      display: grid;
      justify-items: end;
      gap: 2px;
      flex-shrink: 0;
      text-align: right;
    }
    .pay-item-amount {
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
      color: var(--color-ink);
    }
    .pay-item-per {
      font-size: 0.8125rem;
      color: var(--color-ink-muted);
      white-space: nowrap;
    }
    .pay-trial {
      margin: 16px 0 0;
      padding: 12px 14px;
      border-radius: var(--radius-sm);
      background: var(--color-accent-soft);
      color: var(--color-accent);
      line-height: 1.5;
    }
    .pay-trial[hidden] {
      display: none;
    }
    .pay-trial-title {
      margin: 0;
      font-weight: 700;
      font-size: 0.9375rem;
    }
    .pay-trial-text {
      margin: 2px 0 0;
      font-size: 0.875rem;
    }
    .pay-section {
      margin: 20px 0 0;
      font-size: 0.8125rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--color-ink-faint);
    }
    .pay-then {
      margin-top: 4px;
    }
    .pay-then[hidden] {
      display: none;
    }
    .pay-totals {
      margin: 12px 0 0;
      display: grid;
      gap: 10px;
    }
    .pay-row {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      color: var(--color-ink-muted);
    }
    .pay-row[hidden] {
      display: none;
    }
    .pay-row dd {
      margin: 0;
      font-variant-numeric: tabular-nums;
    }
    .pay-row-total {
      padding-top: 12px;
      border-top: 1px solid var(--color-line);
      font-weight: 700;
      font-size: 1.0625rem;
      color: var(--color-ink);
    }
    .pay-fine {
      margin: 16px 0 0;
      font-size: 0.8125rem;
      color: var(--color-ink-faint);
    }
    .pay-fine a {
      color: var(--color-accent);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  </style>
</Base>
