---
import Base from '../layouts/Base.astro';
import Nav from '../components/chrome/Nav.astro';
import Footer from '../components/chrome/Footer.astro';
import Hero from '../components/home/Hero.astro';
import Pillars from '../components/home/Pillars.astro';
import TryChat from '../components/home/TryChat.astro';
import Channels from '../components/home/Channels.astro';
import Continuous from '../components/home/Continuous.astro';
import Handoff from '../components/home/Handoff.astro';
import Inbox from '../components/home/Inbox.astro';
import Pricing from '../components/home/Pricing.astro';
import FinalCta from '../components/home/FinalCta.astro';
---

<Base>
  <Nav />
  <main id="main">
    <Hero />
    <Pillars />
    <TryChat />
    <Channels />
    <Continuous />
    <Handoff />
    <Inbox />
    <Pricing />
    <FinalCta />
