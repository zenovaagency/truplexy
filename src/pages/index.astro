---
import Base from '../layouts/Base.astro';
import Nav from '../components/chrome/Nav.astro';
import Footer from '../components/chrome/Footer.astro';
import Hero from '../components/home/Hero.astro';
import ProductVideo from '../components/home/ProductVideo.astro';
import WhatIs from '../components/home/WhatIs.astro';
import Demo from '../components/home/Demo.astro';
import Pillars from '../components/home/Pillars.astro';
import Channels from '../components/home/Channels.astro';
import Handoff from '../components/home/Handoff.astro';
import Inbox from '../components/home/Inbox.astro';
import Pricing from '../components/home/Pricing.astro';
import Trust from '../components/home/Trust.astro';
import Faq from '../components/home/Faq.astro';
import About from '../components/home/About.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { SITE } from '../data/site';
import { faqSchema } from '../data/faq';
---

<Base chat schema={[faqSchema(new URL('/', Astro.site ?? SITE.url).href)]}>
  <Nav />
  <main id="main">
    <Hero />
    <ProductVideo />
    <WhatIs />
    <Demo />
    <Pillars />
    <Inbox />
    <Channels />
    <Handoff />
    <Pricing />
    <Trust />
    <Faq />
    <About />
    <FinalCta />
  </main>
  <Footer />
</Base>
