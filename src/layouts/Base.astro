---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/global.css';
import { SITE } from '../data/site';
import { LEGAL } from '../data/legal';
import { LIVE_CHANNELS } from '../data/channels';
import BubblyChat from '../components/chrome/BubblyChat.astro';

interface Props {
  title?: string;
  description?: string;
  /** Pages that should stay out of search (404). */
  noindex?: boolean;
  /**
   * Trail from the home page to this one, for the BreadcrumbList schema.
   * Home is added automatically; list only pages that exist.
   */
  breadcrumbs?: { name: string; path: string }[];
  /** Show Bubbly, the site's own chat (the widget in demo mode). */
  chat?: boolean;
}
const { title = SITE.title, description = SITE.description, noindex = false, breadcrumbs, chat = false } = Astro.props;
const site = Astro.site ?? new URL(SITE.url);
// One canonical form per page: no trailing slash (matches trailingSlash: 'never').
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path, site).href;
const ogImage = new URL('/og-card.png', site).href;
const siteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// Organization, WebSite and SoftwareApplication, tied together by @id, plus a
// WebPage for this URL and breadcrumbs on inner pages. All of it restates what
// is visibly true on the page. No offers, ratings, reviews or `sameAs`: none
// exist yet, and nothing here is invented. When an official profile (LinkedIn,
// X, GitHub …) is published, add its URL to `sameAs` on the Organization.
const ORG_ID = `${SITE.url}/#org`;
const WEBSITE_ID = `${SITE.url}/#website`;
const APP_ID = `${SITE.url}/#software`;
const identity = `${SITE.name} is an independent AI customer support platform from ${LEGAL.entity}. It is not Perplexity AI and is not affiliated with Perplexity.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORG_ID,
      name: SITE.name,
      url: SITE.url,
      logo: `${SITE.url}/icon-512.png`,
      slogan: SITE.tagline,
      email: SITE.email,
      description: SITE.description,
      disambiguatingDescription: identity,
      parentOrganization: { '@type': 'Organization', name: LEGAL.entity, url: LEGAL.entityUrl },
    },
    {
      '@type': 'WebSite',
      '@id': WEBSITE_ID,
      name: SITE.name,
      url: SITE.url,
      description: SITE.description,
      inLanguage: 'en',
      publisher: { '@id': ORG_ID },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': APP_ID,
      name: SITE.name,
      applicationCategory: 'BusinessApplication',
      applicationSubCategory: 'AI customer support',
      operatingSystem: 'Web',
      description: SITE.description,
      disambiguatingDescription: identity,
      url: SITE.url,
      publisher: { '@id': ORG_ID },
      featureList: [
        'Human-like AI customer conversations',
        `AI assistant on every live channel: ${LIVE_CHANNELS.map((c) => c.name).join(', ')}`,
        'One platform where your team manages every conversation',
        'Unified inbox with AI summary and intent',
        'Answers from your business knowledge, with sources',
        'Support 24/7, including outside business hours',
        'Human handoff with the conversation and context already there',
      ],
    },
    ...(noindex
      ? []
      : [
          {
            '@type': 'WebPage',
            '@id': `${canonical}#webpage`,
            url: canonical,
            name: title,
            description,
            inLanguage: 'en',
            isPartOf: { '@id': WEBSITE_ID },
            about: { '@id': APP_ID },
            ...(breadcrumbs?.length ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
          },
        ]),
    ...(breadcrumbs?.length
      ? [
          {
            '@type': 'BreadcrumbList',
            '@id': `${canonical}#breadcrumb`,
            itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumbs].map((crumb, i) => ({
              '@type': 'ListItem',
              position: i + 1,
              name: crumb.name,
              item: new URL(crumb.path, site).href,
            })),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={robots} />
    {siteVerification && <meta name="google-site-verification" content={siteVerification} />}

    <!-- Flag script support before first paint, so JS-only styles (e.g. the
         pricing toggle) apply without a flash. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f6f3ee" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Truplexy — Every channel. One platform." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-[10px] focus:bg-surface focus:px-5 focus:py-3 focus:text-ink focus:shadow-lg"
    >
      Skip to content
    </a>

    <slot />

    {chat && <BubblyChat />}

    <script>
      import { motion } from '../lib/scroll';

      // Smooth scrolling boots after first paint so it never blocks the initial render.
      if ('requestIdleCallback' in window) {
        requestIdleCallback(() => void motion(), { timeout: 900 });
      } else {
        setTimeout(() => void motion(), 1);
      }
    </script>
  </body>
</html>
