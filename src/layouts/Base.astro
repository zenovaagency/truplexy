---
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/global.css';
import { SITE } from '../data/site';
import { LIVE_CHANNELS } from '../data/channels';

interface Props {
  title?: string;
  description?: string;
  /** Pages that should stay out of search (404). */
  noindex?: boolean;
  /**
   * Trail from the home page to this one, for the BreadcrumbList schema.
   * Home is added automatically; list only pages that exist.
   */
  breadcrumbs?: { name: string; path: string }[];
}
const { title = SITE.title, description = SITE.description, noindex = false, breadcrumbs } = Astro.props;
const site = Astro.site ?? new URL(SITE.url);
// One canonical form per page: no trailing slash (matches trailingSlash: 'never').
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path, site).href;
const ogImage = new URL('/og-card.png', site).href;
const siteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// Organization, WebSite and SoftwareApplication, plus breadcrumbs on inner
// pages. No offers, ratings or reviews: schema must describe what is visibly
// true on the page, and none of those exist yet.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#org`,
      name: SITE.name,
      url: SITE.url,
      logo: `${SITE.url}/icon-512.png`,
      slogan: SITE.tagline,
      email: SITE.email,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      name: SITE.name,
      url: SITE.url,
      description: SITE.description,
      inLanguage: 'en',
      publisher: { '@id': `${SITE.url}/#org` },
    },
    ...(breadcrumbs?.length
      ? [
          {
            '@type': 'BreadcrumbList',
            itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumbs].map((crumb, i) => ({
              '@type': 'ListItem',
              position: i + 1,
              name: crumb.name,
              item: new URL(crumb.path, site).href,
            })),
          },
        ]
      : []),
    {
      '@type': 'SoftwareApplication',
      name: SITE.name,
      applicationCategory: 'BusinessApplication',
      applicationSubCategory: 'AI customer support',
      operatingSystem: 'Web',
      description: SITE.description,
      url: SITE.url,
      publisher: { '@id': `${SITE.url}/#org` },
      featureList: [
        'Human-like AI customer conversations',
        `Live channels: ${LIVE_CHANNELS.map((c) => c.name).join(', ')}`,
        'Persistent conversation context across channels',
        'Continuous support outside business hours',
        'Human handoff with full conversation context',
        'Unified inbox with AI summary and intent',
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={robots} />
    {siteVerification && <meta name="google-site-verification" content={siteVerification} />}

    <!-- Flag script support before first paint, so JS-only styles (e.g. the
         pricing toggle) apply without a flash. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f7f8fc" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Truplexy — One conversation. Everywhere." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-[10px] focus:bg-surface focus:px-5 focus:py-3 focus:text-ink focus:shadow-lg"
    >
      Skip to content
    </a>

    <slot />

    <script>
      import { motion } from '../lib/scroll';

      // Smooth scrolling boots after first paint so it never blocks the initial render.
      if ('requestIdleCallback' in window) {
        requestIdleCallback(() => void motion(), { timeout: 900 });
      } else {
        setTimeout(() => void motion(), 1);
      }
    </script>
  </body>
</html>
