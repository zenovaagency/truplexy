---
import { getImage } from 'astro:assets';
import LoopDemo from '../../islands/LoopDemo';
import mark from '../../assets/brand/mark.png';
import { STORE_CHAT } from '../../data/demo';

const markSmall = await getImage({ src: mark, width: 64, format: 'webp' });
---

<section id="demo" class="section scroll-mt-[calc(var(--section-y)*-1)]" aria-labelledby="demo-title">
  <div class="container-t">
    <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-end">
      <div>
        <p class="eyebrow">See it in action</p>
        <h2 id="demo-title" class="h2 mt-5">A real conversation, start to handoff.</h2>
      </div>
      <div class="lg:pb-2">
        <p class="lede">
          Truplexy answers a customer’s questions, remembers what they said, and brings in a person
          the moment one is needed — with the whole conversation attached.
        </p>
        <p class="mono mt-4 text-[0.66rem] text-ink-faint">{STORE_CHAT.store} is a sample store</p>
      </div>
    </div>

    <div class="relative mt-14">
      <div class="absolute inset-x-0 -inset-y-10 -z-10 rounded-[56px] opacity-80 blur-3xl sm:-inset-x-6" style="background: radial-gradient(45% 55% at 20% 40%, var(--glow-a), transparent 70%), radial-gradient(40% 50% at 85% 60%, var(--glow-b), transparent 70%);" aria-hidden="true"></div>
      <LoopDemo client:visible={{ rootMargin: '400px' }} markSrc={markSmall.src} />
    </div>
  </div>
</section>
