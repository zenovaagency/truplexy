---
import Button from '../ui/Button.astro';
import { SITE } from '../../data/site';

// Threads converging from the edges toward the right of the band: every
// channel, one conversation. Stretched across the full width, behind the copy.
const threads = [
  'M-10 20 C 300 30, 520 150, 900 120',
  'M-10 90 C 320 90, 540 140, 900 120',
  'M-10 160 C 330 165, 560 135, 900 120',
  'M-10 230 C 320 225, 540 150, 900 120',
  'M1210 20 C 1100 40, 1000 100, 900 120',
  'M1210 220 C 1100 200, 1000 140, 900 120',
];
---

<!-- One dark band with the footer below it. No card: the section is the panel. -->
<section class="relative isolate overflow-hidden bg-ink text-white" aria-labelledby="cta-title">
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: radial-gradient(60% 70% at 18% 0%, rgb(35 56 230 / 0.55), transparent 70%), radial-gradient(50% 60% at 88% 10%, rgb(106 43 255 / 0.4), transparent 70%);"
    aria-hidden="true"
  >
  </div>
  <svg class="pointer-events-none absolute inset-0 -z-10 h-full w-full opacity-[0.22]" viewBox="0 0 1200 240" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="cta-thread" x1="0" x2="1">
        <stop offset="0" stop-color="#45d4ff" stop-opacity="0" />
        <stop offset="0.45" stop-color="#45d4ff" />
        <stop offset="1" stop-color="#d9b8ff" />
      </linearGradient>
    </defs>
    {threads.map((d) => <path d={d} fill="none" stroke="url(#cta-thread)" stroke-width="1.2" vector-effect="non-scaling-stroke" />)}
  </svg>

  <div class="container-t pb-[clamp(48px,6vw,88px)] pt-[clamp(72px,10vw,152px)]">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:items-end lg:gap-16">
      <div>
        <h2 id="cta-title" class="display text-balance text-[clamp(2.4rem,1.3rem+4.4vw,5rem)]">
          Wherever they message,
          <span class="gradient-text-on-dark block">Truplexy is there.</span>
        </h2>
        <p class="mt-7 max-w-[580px] text-[clamp(1.05rem,1rem+0.35vw,1.25rem)] leading-relaxed text-white/75">
          Give customers one continuous support experience across every channel you connect — without making
          every conversation feel like it came from a bot.
        </p>
      </div>

      <div class="lg:pb-2">
        <div class="flex flex-wrap items-center gap-3">
          <Button href={SITE.signupUrl} variant="light">Get started</Button>
          <Button href={SITE.demoUrl} variant="onDark" arrow={false}>Book a demo</Button>
        </div>
        <p class="mono mt-7 text-white/60">Multi-platform. Continuous. Human when it matters.</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Brand ramp for dark grounds: the cyan end is legible here. */
  .gradient-text-on-dark {
    background: linear-gradient(95deg, #45d4ff 0%, #8f9bff 50%, #d9b8ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.08em;
  }
</style>
