---
import Button from '../ui/Button.astro';
import Mark from '../brand/Mark.astro';
import { SITE } from '../../data/site';
---

<!-- One dark band with the footer below it. No card: the section is the panel.
     Behind the copy, the mark at full size in outline: its bars sit apart
     until the band scrolls into view, then lock together. -->
<section class="cta relative isolate overflow-hidden bg-ink text-white" aria-labelledby="cta-title" data-cta>
  <div class="cta-glow pointer-events-none absolute -z-10" aria-hidden="true"></div>
  <Mark class="cta-mark pointer-events-none absolute -z-10" />

  <div class="container-t pb-[clamp(48px,6vw,88px)] pt-[clamp(72px,10vw,152px)]">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:items-end lg:gap-16">
      <div>
        <h2 id="cta-title" class="display text-balance text-[clamp(2.4rem,1.3rem+4.4vw,5rem)]">
          Wherever they message,
          <span class="gradient-text-on-dark block">Truplexy is there.</span>
        </h2>
        <p class="mt-7 max-w-[580px] text-[clamp(1.05rem,1rem+0.35vw,1.25rem)] leading-relaxed text-white/75">
          Customer support, managed from one place: an AI assistant on every channel you connect, and your team
          there the moment a person matters.
        </p>
      </div>

      <div class="lg:pb-2">
        <div class="flex flex-wrap items-center gap-3">
          <Button href={SITE.signupUrl} variant="light">Get started</Button>
          <Button href={SITE.demoUrl} variant="onDark" arrow={false}>Book a demo</Button>
        </div>
        <p class="mono mt-7 text-white/60">Every channel. One platform. Human when it matters.</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Bubbly's colours, legible on ink. */
  .gradient-text-on-dark {
    background: var(--gradient-bubbly);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.08em;
  }

  .cta-glow {
    right: -10%;
    top: -30%;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(197 166 255 / 0.22), rgb(114 196 255 / 0.1) 55%, transparent);
  }

  /* The outlined mark: oversized, off the right edge. */
  .cta :global(.cta-mark) {
    right: -6%;
    top: 50%;
    width: min(760px, 70vw);
    height: auto;
    translate: 0 -50%;
    fill: none;
    stroke: rgb(255 255 255 / 0.14);
    stroke-width: 1.4;
  }
  .cta :global(.cta-mark .bar) {
    vector-effect: non-scaling-stroke;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 1.4s var(--ease-out-expo), stroke 1.2s var(--ease-out-expo);
  }
  /* Apart until the band is in view (only when JS can bring them home). */
  :global(.js) .cta:not(.is-locked) :global(.cta-mark .bar) {
    transform: translate(calc(var(--dx) * -70px + var(--dy) * 26px), calc(var(--dy) * -70px - var(--dx) * 26px));
  }
  .cta.is-locked :global(.cta-mark .bar) { stroke: rgb(255 255 255 / 0.2); }
  .cta :global(.cta-mark .bar-1) { transition-delay: 0.12s; }
  .cta :global(.cta-mark .bar-2) { transition-delay: 0.24s; }

  @media (prefers-reduced-motion: reduce) {
    .cta :global(.cta-mark .bar) { transform: none !important; transition: none; }
  }
</style>

<script>
  const cta = document.querySelector<HTMLElement>('[data-cta]');
  if (cta) {
    new IntersectionObserver(
      ([e], io) => {
        if (!e.isIntersecting) return;
        cta.classList.add('is-locked');
        io.disconnect();
      },
      { threshold: 0.35 },
    ).observe(cta);
  }
</script>
