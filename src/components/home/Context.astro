---
import ChannelIcon from '../ui/ChannelIcon';
import { CONTEXT } from '../../data/demo';

const carried = [
  'Previous questions',
  'Products discussed',
  'The current support issue',
  'Customer preferences',
  'Recent actions',
  'Order or subscription context',
  'Previous handoff state',
];
---

<section id="context" class="section scroll-mt-[var(--nav-h)]" aria-labelledby="context-title">
  <div class="container-t grid items-center gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-20">
    <div>
      <p class="eyebrow" data-reveal>Context shouldn’t disappear when the tab closes</p>
      <h2 id="context-title" class="h2 mt-5" data-split>It remembers where the conversation left off.</h2>
      <p class="lede mt-6" data-reveal>
        Generic chatbots often treat every session like a brand-new customer. Truplexy is built around
        conversational continuity, so the context that matters comes along to the next conversation — on
        whichever connected channel the customer picks.
      </p>

      <ul class="mt-8 grid gap-x-6 gap-y-3 sm:grid-cols-2" data-reveal>
        {carried.map((c) => (
          <li class="flex items-center gap-3 text-[0.95rem]">
            <span class="grid h-6 w-6 flex-none place-items-center rounded-full bg-accent-soft text-accent" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </span>
            {c}
          </li>
        ))}
      </ul>

      <p class="mt-10 text-[clamp(1.4rem,1.1rem+1vw,1.9rem)] font-bold tracking-tight" data-reveal>
        No unnecessary repetition.
      </p>
      <!-- PLACEHOLDER copy — confirm against Truplexy's actual data handling before launch. -->
      <p class="mt-3 max-w-[520px] text-[0.875rem] leading-relaxed text-ink-faint" data-reveal>
        Context is used to continue that customer’s support conversations, from the channels you connect.
      </p>
    </div>

    <div class="relative" data-reveal>
      <div class="absolute -inset-y-8 inset-x-0 -z-10 rounded-[48px] opacity-80 blur-3xl sm:-inset-8" style="background: radial-gradient(55% 50% at 20% 10%, var(--glow-a), transparent 70%), radial-gradient(55% 55% at 90% 90%, var(--glow-b), transparent 70%);" aria-hidden="true"></div>

      <div class="relative flex flex-col">
        {[CONTEXT.before, CONTEXT.after].map((block, bi) => (
          <>
            {bi === 1 && (
              <div class="relative flex h-24 items-center justify-center" aria-hidden="true">
                <span class="thread absolute inset-y-0 left-1/2 -translate-x-1/2"></span>
                <span class="relative chip border border-accent/25 bg-surface text-[0.78rem] text-accent shadow-sm">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>
                  Remembered: plan discussed → Starter
                </span>
              </div>
            )}
            <article class:list={['card overflow-hidden !rounded-[24px]', bi === 0 ? 'sm:mr-12' : 'sm:ml-12 !shadow-[var(--shadow-md)]']}>
              <header class="flex items-center gap-2 border-b border-line bg-surface-2/60 px-5 py-3">
                <ChannelIcon id={block.channel} size={14} />
                <span class="mono text-ink">{block.label}</span>
              </header>
              <div class="flex flex-col gap-2.5 p-5">
                {block.messages.map((m) => (
                  <div class:list={['bubble', m.from === 'customer' ? 'bubble-customer' : 'bubble-ai']}>
                    {m.from === 'ai' && <span class="mb-0.5 block text-[0.72rem] font-semibold text-ink-faint">Truplexy</span>}
                    {m.text}
                  </div>
                ))}
                {bi === 1 && (
                  <div class="mt-2 rounded-2xl border border-dashed border-line-strong px-4 py-3 text-[0.85rem] text-ink-faint">
                    <span class="mono mr-2 text-[0.62rem]">Without context</span>
                    <s class="decoration-ink-faint/70">“Sorry, which plans are you comparing? Could you give me more details?”</s>
                  </div>
                )}
              </div>
            </article>
          </>
        ))}
        <p class="mono mt-4 text-right text-[0.62rem] text-ink-faint">Sample conversation</p>
      </div>
    </div>
  </div>
</section>
