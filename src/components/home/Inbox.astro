---
import { getImage } from 'astro:assets';
import UnifiedInbox from '../../islands/UnifiedInbox';
import mark from '../../assets/brand/mark.png';

const markSmall = await getImage({ src: mark, width: 64, format: 'webp' });
---

<section id="inbox" class="section scroll-mt-[calc(var(--section-y)*-1)]" aria-labelledby="inbox-title">
  <div class="container-t">
    <div class="mx-auto max-w-[780px] text-center">
      <p class="eyebrow">Unified inbox</p>
      <h2 id="inbox-title" class="h2 mt-5">One Inbox. Every Conversation.</h2>
      <p class="lede mx-auto mt-6 max-w-[640px]">
        Every conversation lands in one inbox. See what the AI already handled, what each customer
        needs, and what’s waiting for your team — all from one place.
      </p>
    </div>

    <div class="relative mt-14">
      <div class="absolute inset-x-0 -inset-y-10 -z-10 rounded-[56px] opacity-80 blur-3xl sm:-inset-x-6" style="background: radial-gradient(45% 55% at 15% 30%, var(--glow-a), transparent 70%), radial-gradient(45% 55% at 85% 70%, var(--glow-b), transparent 70%);" aria-hidden="true"></div>
      <UnifiedInbox client:visible markSrc={markSmall.src} />
      <p class="mt-4 text-center text-[0.85rem] text-ink-faint">This is the Tickets page of the Truplexy dashboard, with sample data. Pick a view or a ticket to look around.</p>
    </div>
  </div>
</section>
