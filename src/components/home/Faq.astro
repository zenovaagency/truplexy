---
import { FAQS } from '../../data/faq';

// Buyer questions. Each answer is a native <details>, so it opens without JS
// and the full text is in the HTML for people and search alike. The same
// text is in the page's FAQPage JSON-LD (index.astro).
---

<section id="faq" class="section scroll-mt-[calc(var(--section-y)*-1)] bg-ground-white" aria-labelledby="faq-title">
  <div class="container-t">
    <div class="mx-auto max-w-[760px] text-center">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title" class="h2 mt-5">Questions buyers ask us.</h2>
    </div>

    <div class="mx-auto mt-12 max-w-[820px] divide-y divide-line border-y border-line">
      {FAQS.map((f) => (
        <details class="group/faq">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left text-[1.0625rem] font-semibold tracking-tight text-ink [&::-webkit-details-marker]:hidden">
            <h3>{f.q}</h3>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none text-ink-faint transition-transform duration-200 group-open/faq:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </summary>
          <div class="pb-6 pr-10 text-[0.95rem] leading-relaxed text-ink-muted">
            <p>{f.a}</p>
            {f.link && <a href={f.link.href} class="mt-3 inline-block font-medium text-accent underline-offset-4 hover:underline">{f.link.label} →</a>}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
