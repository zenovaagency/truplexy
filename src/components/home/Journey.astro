---
import ChannelIcon from '../ui/ChannelIcon';
import { JOURNEY } from '../../data/demo';
import { channel, type ChannelId } from '../../data/channels';

const capabilities = [
  'Cross-channel identity',
  'Shared conversation history',
  'Persistent context',
  'Customer intent',
  'Personalization',
  'Seamless platform switching',
];

// Every channel the story touches, in order — lit up in the panel as reached.
// Route index i is first reached at story step i (web, then discord, then
// telegram), which is what the panel script relies on.
const route = [...new Set(JOURNEY.flatMap((s) => s.messages.map((m) => m.channel)))] as ChannelId[];

// The panel's rows, each tagged with the step that first fills it.
const rows = JOURNEY.flatMap((s, step) => s.learns.map((l) => ({ ...l, step })));
const latest = new Map<string, { value: string; step: number }[]>();
rows.forEach((r) => latest.set(r.key, [...(latest.get(r.key) ?? []), { value: r.value, step: r.step }]));
---

<section id="journey" class="section scroll-mt-[var(--nav-h)]" aria-labelledby="journey-title">
  <div class="container-t">
    <div class="max-w-[760px]">
      <p class="eyebrow" data-reveal>One conversation across every platform</p>
      <h2 id="journey-title" class="h2 mt-5" data-split>Your customers don’t think in channels.</h2>
      <p class="lede mt-6 max-w-[620px]" data-reveal>
        They message wherever it’s convenient. Truplexy keeps the conversation connected — so a
        question asked on your website is still remembered on Discord, and still understood on Telegram.
      </p>
    </div>

    <div class="mt-16 grid gap-10 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-14">
      <!-- The story -->
      <ol class="relative flex flex-col gap-8" data-journey>
        <span class="thread absolute bottom-10 left-[19px] top-6 opacity-70" aria-hidden="true"></span>

        {JOURNEY.map((s, i) => (
          <li class="relative pl-14" data-journey-step={i} data-reveal>
            <span
              class:list={[
                'absolute left-0 top-3 grid h-10 w-10 place-items-center rounded-full border-2 bg-surface shadow-sm',
                s.channel === 'human' ? 'border-human/40' : 'border-accent/25',
              ]}
            >
              <ChannelIcon id={s.channel} size={17} className={s.channel === 'human' ? 'text-human' : ''} />
            </span>

            <article class="card overflow-hidden">
              <header class="flex flex-wrap items-center justify-between gap-2 border-b border-line bg-surface-2/60 px-5 py-3">
                <p class="mono flex items-center gap-2 text-ink">
                  <span class="font-semibold">{s.time}</span>
                  <span class="text-ink-faint" aria-hidden="true">·</span>
                  <span>{s.label}</span>
                  {s.channel === 'human' && (
                    <span class="text-ink-faint">· on {channel(s.messages[0].channel).name}</span>
                  )}
                </p>
                {i === 1 && <span class="chip bg-accent-soft !py-1 text-[0.72rem] text-accent">No context requested</span>}
                {i === 3 && <span class="chip bg-human-soft !py-1 text-[0.72rem] text-human">Full thread handed over</span>}
              </header>

              <div class="flex flex-col gap-2.5 p-5">
                {s.messages.map((m) => (
                  <div class:list={['bubble', m.from === 'customer' ? 'bubble-customer' : m.from === 'agent' ? 'bubble-agent' : 'bubble-ai']}>
                    {m.from !== 'customer' && (
                      <span class="mb-0.5 block text-[0.72rem] font-semibold text-ink-faint">
                        {m.from === 'agent' ? m.author : 'Truplexy'}
                      </span>
                    )}
                    {m.text}
                  </div>
                ))}
              </div>

              <!-- On small screens the "what Truplexy now knows" panel lives inline. -->
              <footer class="flex flex-wrap items-center gap-1.5 border-t border-dashed border-line px-5 py-3 lg:hidden">
                <span class="mono mr-1 text-[0.66rem] text-ink-faint">Context</span>
                {s.learns.map((l) => (
                  <span class="chip bg-accent-soft !py-1 text-[0.75rem] text-accent">{l.key}: {l.value}</span>
                ))}
              </footer>
            </article>
          </li>
        ))}
      </ol>

      <!-- Shared context panel (desktop) -->
      <aside class="hidden lg:block" aria-label="What Truplexy knows as the conversation moves">
        <div class="sticky top-[calc(var(--nav-h)+28px)]" data-journey-panel>
          <div class="card overflow-hidden !rounded-[28px] !shadow-[var(--shadow-md)]">
            <div class="relative overflow-hidden border-b border-line px-6 pb-5 pt-6">
              <div class="aurora opacity-70" aria-hidden="true"></div>
              <p class="mono relative text-ink-faint">Shared context</p>
              <div class="relative mt-4 flex items-center gap-3">
                <span class="grid h-11 w-11 place-items-center rounded-full text-sm font-bold text-white" style="background: var(--gradient-brand)">NI</span>
                <div>
                  <p class="font-bold">Nabila Islam</p>
                  <p class="text-[0.82rem] text-ink-muted">One customer · one conversation</p>
                </div>
              </div>
              <div class="relative mt-5 flex items-center gap-1.5">
                {route.map((id, i) => (
                  <>
                    {i > 0 && <span class="h-[2px] w-6 rounded bg-line transition-colors duration-500 data-[on]:bg-accent" data-ctx-step={i} data-on aria-hidden="true"></span>}
                    <span
                      class="flex items-center gap-1.5 rounded-full border border-line bg-surface px-2.5 py-1 text-[0.75rem] font-medium opacity-40 transition-opacity duration-500 data-[on]:opacity-100"
                      data-ctx-step={i}
                      data-on
                    >
                      <ChannelIcon id={id} size={12} />
                      {channel(id).name === 'Website chat' ? 'Web' : channel(id).name}
                    </span>
                  </>
                ))}
              </div>
            </div>

            <dl class="divide-y divide-line">
              {[...latest.entries()].map(([key, values]) => (
                <div class="grid grid-cols-[110px_1fr] gap-3 px-6 py-3.5">
                  <dt class="mono pt-0.5 text-[0.68rem] text-ink-faint">{key}</dt>
                  <dd class="grid text-[0.92rem] font-medium">
                    <span class="[grid-area:1/1] text-ink-faint" aria-hidden="true">—</span>
                    {values.map((v, vi) => (
                      <span
                        class="ctx-val [grid-area:1/1] bg-surface opacity-0 transition-opacity duration-500 data-[on]:opacity-100"
                        data-ctx-step={v.step}
                        data-on={vi === values.length - 1 ? '' : undefined}
                      >
                        {v.value}
                      </span>
                    ))}
                  </dd>
                </div>
              ))}
            </dl>

            <p class="border-t border-line bg-surface-2/60 px-6 py-4 text-[0.82rem] text-ink-muted">
              Nothing above was asked twice. Each channel picked up where the last one left off.
            </p>
          </div>
        </div>
      </aside>
    </div>

    <ul class="mt-14 flex flex-wrap gap-2" aria-label="What makes this possible" data-reveal>
      {capabilities.map((c) => (
        <li class="chip border border-line bg-surface text-ink-muted">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          {c}
        </li>
      ))}
    </ul>

    <!-- Signature line -->
    <div class="relative mt-[clamp(72px,9vw,128px)] text-center" data-reveal>
      <div class="thread-h mx-auto mb-10 w-24" aria-hidden="true"></div>
      <p class="display mx-auto max-w-[980px] text-[clamp(2.2rem,1.2rem+4.2vw,4.6rem)]">
        The channel changes.
        <span class="gradient-text block">The conversation doesn’t.</span>
      </p>
    </div>
  </div>
</section>

<script>
  // Lights up the shared-context panel as each step of the story reaches the
  // middle of the viewport. The server render has everything lit, so with
  // no JS (or reduced motion) the panel simply shows the finished profile.
  const steps = document.querySelectorAll<HTMLElement>('[data-journey-step]');
  const panel = document.querySelector<HTMLElement>('[data-journey-panel]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (panel && steps.length && !reduced) {
    const items = panel.querySelectorAll<HTMLElement>('[data-ctx-step]');
    let reached = -1;

    const paint = () => {
      items.forEach((el) => {
        const step = Number(el.dataset.ctxStep);
        // Values: show only the latest reached value for each key.
        if (el.classList.contains('ctx-val')) {
          const siblings = [...el.parentElement!.querySelectorAll<HTMLElement>('.ctx-val')];
          const best = siblings.filter((s) => Number(s.dataset.ctxStep) <= reached).at(-1);
          el.toggleAttribute('data-on', el === best);
        } else {
          el.toggleAttribute('data-on', step <= reached);
        }
      });
    };

    paint();

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const i = Number((e.target as HTMLElement).dataset.journeyStep);
          if (i > reached) {
            reached = i;
            paint();
          }
        });
      },
      { rootMargin: '-40% 0px -45% 0px' },
    );
    steps.forEach((s) => io.observe(s));
  }
</script>
