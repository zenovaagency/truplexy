---
import { LEGAL } from '../../data/legal';
import { SITE } from '../../data/site';
import { channelsIn, listNames } from '../../data/channels';

// A plain-language definition of the product, in readable HTML rather than
// behind any interaction, so people, search engines and AI assistants all get
// the same answers. Channel names come from the registry, so the list follows
// what is live and the copy never promises a channel that isn't.
const messaging = listNames(channelsIn('messaging').filter((c) => c.status === 'live'));

const answers = [
  {
    q: 'What does Truplexy do?',
    a: 'It answers customers for you on every channel you use, in your team’s tone, day and night, and brings every conversation into one inbox for your team. When a person adds value, your team takes over with the conversation and context already there.',
  },
  {
    q: 'Who is it for?',
    a: 'Businesses that support customers on more than one channel — from small teams on the Starter plan to larger organisations that need Enterprise.',
  },
  {
    q: 'What problems does it solve?',
    a: 'Teams jumping between separate apps for each channel, messages that get missed, questions that arrive outside business hours, and chatbots that leave people stuck with no way to reach a person.',
  },
  {
    q: 'Which channels does it support?',
    a: `${messaging}, plus business platforms, team inboxes and a REST API.`,
    link: { href: '/channels', label: 'See every channel' },
  },
  {
    q: 'How is it different from a traditional chatbot?',
    a: 'A typical chatbot lives on one channel and loops through canned answers. Truplexy runs on every channel, answers from your own knowledge with the source attached, puts every conversation in one inbox, and hands over to a person instead of dead-ending.',
    link: { href: '/docs', label: 'Read the documentation' },
  },
];
---

<section id="what-is-truplexy" class="section scroll-mt-[calc(var(--section-y)*-1)] bg-ground-white" aria-labelledby="what-is-title">
  <div class="container-t">
    <div class="mx-auto max-w-[800px] text-center">
      <p class="eyebrow">About</p>
      <h2 id="what-is-title" class="h2 mt-5">What is Truplexy?</h2>
      <p class="lede mx-auto mt-5 max-w-[680px] text-[1.0625rem]">
        {SITE.name} is an independent AI customer support platform. It puts an AI assistant on every channel a
        business’s customers use, and gives its team one platform to manage every conversation.
      </p>
    </div>

    <dl class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {answers.map((item) => (
        <div class="flex flex-col rounded-[20px] border border-line bg-ground-cream p-6">
          <dt class="text-[1.0625rem] font-semibold tracking-tight">{item.q}</dt>
          <dd class="mt-2 flex-1 text-[0.92rem] leading-relaxed text-ink-muted">
            {item.a}
            {item.link && (
              <a href={item.link.href} class="mt-3 block font-medium text-accent underline-offset-4 hover:underline">{item.link.label} →</a>
            )}
          </dd>
        </div>
      ))}
      <div class="flex flex-col rounded-[20px] border border-line bg-ground-cream p-6">
        <dt class="text-[1.0625rem] font-semibold tracking-tight">Is it related to Perplexity?</dt>
        <dd class="mt-2 flex-1 text-[0.92rem] leading-relaxed text-ink-muted">
          No. {SITE.name} is a separate product from {LEGAL.entity} and is not Perplexity AI or affiliated with Perplexity.
        </dd>
      </div>
    </dl>
  </div>
</section>
