---
import Button from '../ui/Button.astro';
import ChannelIcon from '../ui/ChannelIcon';
import HeroStage from './HeroStage.astro';
import { channel, channelsIn } from '../../data/channels';
import { SITE } from '../../data/site';

// Live customer-messaging channels are named as-is; any flagship messaging
// app not yet live is shown faded with an explicit "Coming soon" label.
// Both read the registry.
const heroLive = channelsIn('messaging').filter((c) => c.status === 'live');
const upcoming = (['whatsapp', 'messenger', 'instagram'] as const).map(channel).filter((c) => c.status === 'soon');
---

<!-- Fills the first screen (capped on tall monitors). Copy on the left; on
     the right, the stage shows the tagline happening: questions from every
     channel reach the assistant and land in one inbox. -->
<section class="hero relative isolate overflow-hidden border-b border-line bg-surface">
  <div class="grid-fade -z-10" aria-hidden="true"></div>
  <div class="container-t relative grid min-h-[min(100svh,960px)] items-center gap-14 pb-16 pt-[calc(var(--nav-h)+40px)] lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-10 lg:pb-14">
    <div class="flex flex-col items-center text-center lg:items-start lg:text-left">
      <p class="eyebrow">Your customers have questions. Anytime. Everywhere.</p>

      <h1 class="display mt-6 text-[clamp(2.9rem,1.4rem+4.6vw,5.4rem)] !font-bold !leading-[0.98] !tracking-[-0.05em]">
        Every channel.
        <span class="tone-2 block">One platform.</span>
      </h1>

      <p class="lede mt-7 max-w-[540px] !text-[clamp(1rem,0.95rem+0.25vw,1.125rem)]">
        Truplexy puts a human-like AI assistant on every channel you already use, and gives your team
        one platform to manage every conversation.
      </p>

      <div class="mt-8 flex w-full max-w-[340px] flex-col items-stretch gap-3 sm:w-auto sm:max-w-none sm:flex-row sm:items-center">
        <Button href={SITE.signupUrl}>Start free trial</Button>
        <Button href="#demo" variant="ghost" arrow={false}>See it in action</Button>
      </div>

      <p class="mono mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-[0.68rem] text-ink-faint lg:justify-start">
        <span>AI on every channel</span><span aria-hidden="true" class="text-line-strong">·</span>
        <span>One inbox for your team</span><span aria-hidden="true" class="text-line-strong">·</span>
        <span>Human when it matters</span>
      </p>

      <!-- Where Truplexy runs today. Stands in for a customer-logo strip. -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-4 gap-y-3 border-t border-line pt-7 lg:justify-start">
        <ul class="flex items-center" aria-label={`Live on ${heroLive.map((c) => c.name).join(', ')}`}>
          {heroLive.map((c, i) => (
            <li class:list={['grid h-9 w-9 place-items-center rounded-full border border-line bg-surface shadow-[var(--shadow-sm)] ring-2 ring-surface', i > 0 && '-ml-2']} title={c.name}>
              <ChannelIcon id={c.id} size={17} strokeWidth={2.25} />
            </li>
          ))}
        </ul>
        <p class="text-[0.9rem] text-ink-muted">
          <span class="font-semibold text-ink">Live on {heroLive.length} channels</span> your customers already use
        </p>
        {upcoming.length > 0 && (
          <p class="flex items-center gap-2 text-[0.85rem] text-ink-faint">
            {upcoming.map((c) => c.name).join(', ')}
            <span class="soon-tag">Coming soon</span>
          </p>
        )}
      </div>
    </div>

    <div class="relative">
      <HeroStage />
      <p class="mt-5 text-center text-[0.85rem] text-ink-faint">
        Sample conversations.{' '}
        <button type="button" class="font-semibold text-ink underline decoration-line-strong underline-offset-4 hover:decoration-ink" data-open-chat>
          Ask the assistant yourself →
        </button>
      </p>
    </div>
  </div>
</section>
