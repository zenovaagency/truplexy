---
import DayCycle from '../../islands/DayCycle';
---

<section id="continuous" class="section scroll-mt-[var(--nav-h)]" aria-labelledby="continuous-title">
  <div class="container-t">
    <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-end">
      <div>
        <p class="eyebrow" data-reveal>Continuous support</p>
        <h2 id="continuous-title" class="h2 mt-5" data-split>Support doesn’t clock out.</h2>
      </div>
      <p class="lede lg:pb-2" data-reveal>
        Customers need answers before work, after work, during weekends and across time zones.
        Truplexy stays available — while knowing when a real person should step in.
      </p>
    </div>

    <div class="relative mt-14" data-reveal>
      <div class="absolute inset-x-0 -inset-y-10 -z-10 rounded-[56px] opacity-70 blur-3xl sm:-inset-x-6" style="background: radial-gradient(45% 55% at 12% 20%, var(--glow-a), transparent 70%), radial-gradient(45% 55% at 88% 80%, var(--glow-b), transparent 70%);" aria-hidden="true"></div>
      <DayCycle client:visible={{ rootMargin: '400px' }} />
      <p class="mono mt-4 text-center text-[0.66rem] text-ink-faint">Sample day · pick any moment</p>
    </div>

    <p class="display mx-auto mt-[clamp(64px,8vw,112px)] max-w-[900px] text-center text-[clamp(1.9rem,1.2rem+2.6vw,3.3rem)]" data-reveal>
      AI when it can. Humans when they matter.
      <span class="gradient-text block">Support without interruption.</span>
    </p>
  </div>
</section>
