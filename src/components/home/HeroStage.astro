---
/**
 * The hero's "convergence stage": questions arrive from different channels,
 * reach Bubbly, and each lands in the team's inbox, answered by the AI or
 * handed to a person. Every channel, one platform, shown rather than said.
 *
 * Server-rendered in its resting state (the latest questions in the lane,
 * the inbox full, the last reply showing), so it reads without JS and under
 * reduced motion. The script then keeps new questions arriving: chips and
 * rows are cloned from per-item <template>s and moved by `--p` (their
 * position in the stack) with CSS transitions. It pauses off screen and in
 * background tabs.
 *
 * Bubbly opens the real chat (BubblyChat listens for [data-open-chat]).
 */
import Bubbly from '../brand/Bubbly.astro';
import ChannelIcon from '../ui/ChannelIcon';
import { channel } from '../../data/channels';
import { STAGE_ITEMS, STAGE_STORE, outcomeLabel } from '../../data/hero-stage';

const LANE = 3;
const ROWS = 4;
const n = STAGE_ITEMS.length;
// Resting state: newest first.
const recent = (count: number) => Array.from({ length: Math.min(count, n) }, (_, p) => ({ p, i: n - 1 - p }));
const last = STAGE_ITEMS[n - 1];
const names = [...new Set(STAGE_ITEMS.map((s) => channel(s.channel).name))];
---

<div class="stage" data-hero-stage data-count={n}>
  <p class="sr-only">
    Questions from {names.join(', ')} reach the Truplexy assistant. Most are answered straight away, one is handed to a
    person, and every conversation lands in one inbox for the team.
  </p>

  <!-- Incoming -->
  <div class="lane" aria-hidden="true" data-lane>
    {recent(LANE).map(({ p, i }) => {
      const s = STAGE_ITEMS[i];
      return (
        <div class="chip-m" data-p={p} style={`--p: ${p}`}>
          <span class="chip-ico"><ChannelIcon id={s.channel} size={18} /></span>
          <span class="min-w-0">
            <span class="chip-meta">{channel(s.channel).name} · {s.customer}</span>
            <span class="chip-text">{s.ask}</span>
          </span>
        </div>
      );
    })}
  </div>

  <div class="wire" aria-hidden="true" data-wire="in"><span class="wire-dot"></span></div>

  <!-- The assistant -->
  <div class="hub">
    <button type="button" class="hub-btn" data-open-chat aria-label="Chat with the Truplexy assistant">
      <span class="hub-glow" aria-hidden="true"></span>
      <Bubbly size={84} look class="hub-bubbly" />
    </button>
    <div class="say" data-say="reply" aria-hidden="true">
      <span class="typing"><span></span><span></span><span></span></span>
      <span class="say-text" data-say-text>{last.reply}</span>
    </div>
  </div>

  <div class="wire" aria-hidden="true" data-wire="out"><span class="wire-dot"></span></div>

  <!-- The team's inbox -->
  <div class="inbox" aria-hidden="true">
    <div class="inbox-head">
      <span class="flex items-center gap-2 font-semibold"><span class="live-dot"></span>Inbox</span>
      <span class="mono text-[0.6rem] text-ink-faint">{STAGE_STORE} · sample store</span>
    </div>
    <div class="rows" data-rows>
      {recent(ROWS).map(({ p, i }) => {
        const s = STAGE_ITEMS[i];
        return (
          <div class="row" data-p={p} style={`--p: ${p}`}>
            <span class="row-ico"><ChannelIcon id={s.channel} size={16} /></span>
            <span class="min-w-0 flex-1">
              <span class="row-name">{s.customer}</span>
              <span class="row-text">{s.ask}</span>
            </span>
            <span class:list={['row-status', s.outcome]}>{outcomeLabel(s)}</span>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Clone sources for the loop. -->
  {STAGE_ITEMS.map((s, i) => (
    <>
      <template data-chip={i}>
        <div class="chip-m">
          <span class="chip-ico"><ChannelIcon id={s.channel} size={18} /></span>
          <span class="min-w-0">
            <span class="chip-meta">{channel(s.channel).name} · {s.customer}</span>
            <span class="chip-text">{s.ask}</span>
          </span>
        </div>
      </template>
      <template data-row={i} data-reply={s.reply}>
        <div class="row">
          <span class="row-ico"><ChannelIcon id={s.channel} size={16} /></span>
          <span class="min-w-0 flex-1">
            <span class="row-name">{s.customer}</span>
            <span class="row-text">{s.ask}</span>
          </span>
          <span class:list={['row-status', s.outcome]}>{outcomeLabel(s)}</span>
        </div>
      </template>
    </>
  ))}
</div>

<style>
  .stage {
    --chip-h: 58px;
    --chip-gap: 10px;
    --row-h: 52px;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 500px;
    margin-inline: auto;
  }

  /* ---------------------------------------------------------------- lane */
  .lane {
    position: relative;
    width: 100%;
    max-width: 400px;
    height: calc(var(--chip-h) * 3 + var(--chip-gap) * 2);
  }

  .chip-m {
    position: absolute;
    inset-inline: 0;
    top: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    height: var(--chip-h);
    padding: 0 14px 0 10px;
    border: 1px solid var(--color-line);
    border-radius: 16px;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transform: translateY(calc(var(--p) * (var(--chip-h) + var(--chip-gap)))) scale(calc(1 - var(--p) * 0.04));
    opacity: calc(1 - var(--p) * 0.32);
    transition:
      transform 600ms var(--ease-out-expo),
      opacity 500ms var(--ease-out-expo),
      box-shadow 300ms,
      border-color 300ms;
  }
  .chip-m.is-enter { transform: translateY(-24px) scale(0.96); opacity: 0; }
  .chip-m.is-leave { opacity: 0; }
  .chip-m.is-active {
    border-color: var(--color-ink);
    box-shadow: 0 0 0 4px rgb(10 10 10 / 0.06), var(--shadow-md);
  }

  .chip-ico, .row-ico {
    display: grid;
    flex: none;
    place-items: center;
    border-radius: 10px;
    background: var(--color-surface-2);
  }
  .chip-ico { width: 36px; height: 36px; }
  .row-ico { width: 30px; height: 30px; border-radius: 9px; }

  .chip-meta {
    display: block;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-ink-faint);
    line-height: 1.3;
  }
  .chip-text, .row-text {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .chip-text { font-size: 0.9rem; font-weight: 500; line-height: 1.35; }

  /* ---------------------------------------------------------------- wires */
  .wire {
    position: relative;
    width: 2px;
    height: 34px;
    margin-block: 6px;
    background: repeating-linear-gradient(to bottom, var(--color-line-strong) 0 4px, transparent 4px 8px);
  }
  .wire-dot {
    position: absolute;
    left: 50%;
    top: 0;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    border-radius: 50%;
    background: var(--color-ink);
    box-shadow: 0 0 0 3px var(--color-surface);
    opacity: 0;
  }
  .wire.is-run .wire-dot { animation: wire-run 620ms cubic-bezier(0.45, 0, 0.25, 1) both; }
  @keyframes wire-run {
    0% { top: -4px; opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { top: calc(100% - 4px); opacity: 0; }
  }

  /* ---------------------------------------------------------------- hub */
  .hub {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .hub-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 112px;
    height: 112px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-md);
    transition: transform 420ms var(--ease-spring);
    -webkit-tap-highlight-color: transparent;
  }
  @media (hover: hover) and (pointer: fine) {
    .hub-btn:hover { transform: scale(1.05); }
  }
  .hub-btn:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 4px; border-radius: 50%; }
  .hub-btn :global(.hub-bubbly) { position: relative; margin: 6px 0 0 6px; }

  .hub-glow {
    position: absolute;
    inset: -10px;
    z-index: -1;
    border-radius: 50%;
    border: 1px solid var(--color-line);
    opacity: 0.7;
    transition: opacity 400ms, transform 500ms var(--ease-out-expo);
  }
  .stage.is-thinking .hub-glow { opacity: 1; transform: scale(1.12); border-color: var(--color-line-strong); }

  /* Typing, then the reply, beside Bubbly. */
  .say {
    position: absolute;
    left: calc(50% + 70px);
    top: 50%;
    width: max-content;
    max-width: min(200px, calc(50% - 74px));
    padding: 9px 12px;
    border: 1px solid var(--color-line);
    border-radius: 16px 16px 16px 4px;
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    font-size: 0.8rem;
    line-height: 1.4;
    translate: 0 -50%;
    transition: opacity 260ms, transform 360ms var(--ease-spring);
  }
  .say .typing { display: none; padding-block: 4px; }
  .say[data-say='typing'] .typing { display: inline-flex; }
  .say[data-say='typing'] .say-text { display: none; }
  .say[data-say='off'] { opacity: 0; transform: scale(0.9) translateX(-6px); }

  /* ---------------------------------------------------------------- inbox */
  .inbox {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: 20px;
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .inbox-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.85rem;
  }
  .rows {
    position: relative;
    height: calc(var(--row-h) * 4);
    overflow: hidden;
  }
  .row {
    position: absolute;
    inset-inline: 0;
    top: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    height: var(--row-h);
    padding: 0 14px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-surface);
    font-size: 0.8rem;
    line-height: 1.3;
    transform: translateY(calc(var(--p) * var(--row-h)));
    transition: transform 600ms var(--ease-out-expo), opacity 500ms, background-color 1.2s;
  }
  .row.is-enter { opacity: 0; transform: translateY(-12px); }
  .row.is-leave { opacity: 0; }
  .row.is-new { background: var(--color-surface-2); }
  .row-name { display: block; font-weight: 600; }
  .row-text { color: var(--color-ink-muted); }
  .row-status {
    flex: none;
    border-radius: 999px;
    padding: 3px 8px;
    font-size: 0.68rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .row-status.resolved { background: var(--color-resolved-soft); color: var(--color-resolved); }
  .row-status.human { background: var(--color-human-soft); color: var(--color-human); }

  /* Phones: two chips, three rows, the reply under Bubbly. */
  @media (max-width: 639px) {
    .lane { height: calc(var(--chip-h) * 2 + var(--chip-gap)); }
    .chip-m[data-p='2'] { opacity: 0; }
    .rows { height: calc(var(--row-h) * 3); }
    /* Bubbly moves left so the reply has room; the wires follow it. */
    .hub { justify-content: flex-start; padding-left: 16px; }
    .wire { align-self: flex-start; margin-left: 63px; }
    .say { left: 128px; max-width: calc(100% - 132px); font-size: 0.78rem; }
    .hub-btn { width: 96px; height: 96px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .chip-m, .row, .say, .hub-glow { transition: none; }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (stage && !still) {
    const lane = stage.querySelector<HTMLElement>('[data-lane]')!;
    const rows = stage.querySelector<HTMLElement>('[data-rows]')!;
    const say = stage.querySelector<HTMLElement>('.say')!;
    const sayText = stage.querySelector<HTMLElement>('[data-say-text]')!;
    const wires = {
      in: stage.querySelector<HTMLElement>('[data-wire="in"]')!,
      out: stage.querySelector<HTMLElement>('[data-wire="out"]')!,
    };
    const count = Number(stage.dataset.count);
    const LANE = 3;
    const ROWS = 4;

    const clone = (sel: string) => (stage.querySelector<HTMLTemplateElement>(sel)!.content.firstElementChild!.cloneNode(true) as HTMLElement);
    const place = (el: HTMLElement, p: number) => {
      el.style.setProperty('--p', String(p));
      el.dataset.p = String(p);
    };

    /** Pushes a new element onto a stack: everything else moves down one; the last falls off. */
    function push(box: HTMLElement, el: HTMLElement, max: number) {
      for (const old of [...box.children] as HTMLElement[]) {
        if (old.classList.contains('is-leave')) continue;
        const p = Number(old.dataset.p) + 1;
        place(old, p);
        old.classList.remove('is-active', 'is-new');
        if (p >= max) {
          old.classList.add('is-leave');
          window.setTimeout(() => old.remove(), 600);
        }
      }
      el.classList.add('is-enter');
      place(el, 0);
      box.prepend(el);
      void el.offsetWidth;
      el.classList.remove('is-enter');
    }

    const run = (wire: HTMLElement) => {
      wire.classList.remove('is-run');
      void wire.offsetWidth;
      wire.classList.add('is-run');
    };

    let i = 0;
    let chip: HTMLElement | null = null;
    // One item: [delay before this step (ms), step].
    const steps: [number, () => void][] = [
      [0, () => {
        say.dataset.say = 'off';
        chip = clone(`[data-chip="${i}"]`);
        push(lane, chip, LANE);
      }],
      [600, () => {
        chip?.classList.add('is-active');
        run(wires.in);
      }],
      [600, () => {
        stage.classList.add('is-thinking');
        say.dataset.say = 'typing';
      }],
      [1000, () => {
        sayText.textContent = stage.querySelector<HTMLElement>(`[data-row="${i}"]`)!.dataset.reply ?? '';
        say.dataset.say = 'reply';
        stage.classList.remove('is-thinking');
      }],
      [1300, () => run(wires.out)],
      [450, () => {
        const row = clone(`[data-row="${i}"]`);
        push(rows, row, ROWS);
        row.classList.add('is-new');
        i = (i + 1) % count;
      }],
      [1400, () => {}],
    ];

    let k = 0;
    let timer = 0;
    let playing = false;
    const tick = () => {
      steps[k][1]();
      k = (k + 1) % steps.length;
      timer = window.setTimeout(tick, steps[k][0]);
    };
    const play = (on: boolean) => {
      if (on === playing) return;
      playing = on;
      window.clearTimeout(timer);
      if (on) timer = window.setTimeout(tick, k === 0 ? 900 : steps[k][0]);
    };

    let visible = false;
    const sync = () => play(visible && !document.hidden);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      sync();
    }).observe(stage);
    document.addEventListener('visibilitychange', sync);
  }
</script>
