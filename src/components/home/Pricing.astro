---
import PlanCards from '../pricing/PlanCards.astro';
import { SITE } from '../../data/site';
---

<section
  id="pricing"
  class="section scroll-mt-[var(--nav-h)] border-y border-line bg-surface"
  aria-labelledby="pricing-title"
>
  <div class="container-t">
    <div class="mx-auto max-w-[760px] text-center">
      <p class="eyebrow" data-reveal>Pricing</p>
      <h2 id="pricing-title" class="h2 mt-5" data-split>Plans that grow with your support.</h2>
      <p class="lede mx-auto mt-6 max-w-[600px]" data-reveal>
        Every plan includes cross-channel customer identity, human handoff and analytics. Upgrade for more
        AI tokens, channels and integrations as your conversations grow.
      </p>
    </div>

    <PlanCards />

    <p class="mt-4 text-center text-[0.9rem] text-ink-faint" data-reveal>
      Not sure which plan fits? <a href={SITE.demoUrl} class="font-semibold text-accent hover:underline">Book a demo</a> and we’ll walk you through it.
    </p>
  </div>
</section>
