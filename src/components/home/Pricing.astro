---
import PlanCards from '../pricing/PlanCards.astro';
import { SITE } from '../../data/site';
---

<section
  id="pricing"
  class="section scroll-mt-[calc(var(--section-y)*-1)] border-y border-line bg-surface"
  aria-labelledby="pricing-title"
>
  <div class="container-t">
    <div class="mx-auto max-w-[760px] text-center">
      <p class="eyebrow">Pricing</p>
      <h2 id="pricing-title" class="h2 mt-5">Plans that grow with your support.</h2>
      <p class="lede mx-auto mt-6 max-w-[600px]">
        Every plan includes every channel, cross-channel customer identity, human handoff and analytics. Try
        Starter or Pro free for 7 days.
      </p>
    </div>

    <PlanCards />

    <p class="mt-4 text-center text-[0.9rem] text-ink-faint">
      Not sure which plan fits? <a href={SITE.demoUrl} class="font-semibold text-accent hover:underline">Book a demo</a> and we’ll walk you through it.
    </p>
  </div>
</section>
