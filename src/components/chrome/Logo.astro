---
/**
 * The Truplexy logo: the Soft Triplex mark and the outlined Chillax
 * wordmark, drawn inline in currentColor (ink on light grounds, white with
 * `onDark`). The paths come from src/assets/brand/brand-paths.ts.
 */
import { LOGO_HEIGHT, LOGO_INNER, LOGO_WIDTH } from '../../assets/brand/brand-paths';

interface Props {
  /** Rendered height in px. */
  height?: number;
  class?: string;
  /** Set to "" when the logo is not itself the link text (e.g. inside a labelled link). */
  alt?: string;
  /** White, for dark grounds. */
  onDark?: boolean;
}
const { height = 30, class: className = '', alt = 'Truplexy', onDark = false } = Astro.props;
const width = Math.round((LOGO_WIDTH / LOGO_HEIGHT) * height);
---

<span class:list={['inline-flex items-center', onDark ? 'text-white' : 'text-ink', className]}>
  <svg
    viewBox={`0 0 ${LOGO_WIDTH} ${LOGO_HEIGHT}`}
    width={width}
    height={height}
    fill="currentColor"
    role={alt ? 'img' : undefined}
    aria-label={alt || undefined}
    aria-hidden={alt ? undefined : 'true'}
    set:html={LOGO_INNER}
  />
</span>
