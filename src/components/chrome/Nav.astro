---
import Logo from './Logo.astro';
import Button from '../ui/Button.astro';
import ChannelIcon from '../ui/ChannelIcon';
import { NAV, SITE } from '../../data/site';
import { LIVE_CHANNELS, SOON_CHANNELS } from '../../data/channels';

// Channels dropdown: every live channel by name, the flagship upcoming
// messaging apps by name, the rest as a count. All read from the registry.
// With nothing upcoming, the live list takes the full panel in two columns.
const FLAGSHIP_SOON: string[] = ['whatsapp', 'messenger', 'instagram'];
const hasSoon = SOON_CHANNELS.length > 0;
const soonNamed = SOON_CHANNELS.filter((c) => FLAGSHIP_SOON.includes(c.id));
const soonMore = SOON_CHANNELS.length - soonNamed.length;
const soonText = soonNamed.map((c) => c.name).join(', ') + (soonMore > 0 ? ` and ${soonMore} more` : '');

const link =
  'inline-flex items-center gap-1 rounded-lg px-3 py-2 text-[0.875rem] font-medium text-ink-muted transition-colors hover:text-ink';
const iconBtn =
  'grid h-10 w-10 place-items-center rounded-lg text-ink-muted transition-colors hover:bg-surface-2 hover:text-ink';
---

<header id="site-nav" class="group/nav fixed inset-x-0 top-3 z-50 sm:top-5">
  <div class="container-t">
    <nav
      class="glass mx-auto flex h-14 max-w-[1120px] items-center justify-between gap-4 rounded-2xl border border-line pl-4 pr-2 shadow-[var(--shadow-sm)] transition-shadow duration-300 group-data-[scrolled]/nav:shadow-[var(--shadow-md)]"
      aria-label="Primary"
    >
      <a href="/" class="-ml-1 rounded-md p-1" aria-label="Truplexy home">
        <Logo height={24} alt="" />
      </a>

      <ul class="hidden items-center gap-0.5 lg:flex">
        {NAV.map((item) =>
          item.href === '#channels' ? (
            <li class="relative">
              <details data-nav-dd class="group/dd">
                <summary class:list={[link, 'cursor-pointer list-none group-open/dd:text-ink [&::-webkit-details-marker]:hidden']}>
                  {item.label}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 group-open/dd:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>

                <div class="card absolute left-1/2 top-[calc(100%+14px)] w-[540px] -translate-x-1/2 !rounded-2xl p-2 !shadow-[var(--shadow-lg)] before:absolute before:inset-x-0 before:-top-4 before:h-4">
                  <div class:list={['grid gap-2', hasSoon && 'grid-cols-[1.15fr_1fr]']}>
                    <div class="rounded-xl p-3">
                      <p class="mono flex items-center gap-2 text-[0.68rem] text-ink-faint"><span class="live-dot" aria-hidden="true"></span>Live now</p>
                      <ul class:list={['mt-3 grid gap-1', !hasSoon && 'grid-cols-2']}>
                        {LIVE_CHANNELS.map((c) => (
                          <li class="flex items-center gap-3 rounded-lg px-2 py-1.5">
                            <span class="grid h-8 w-8 flex-none place-items-center rounded-lg border border-line bg-surface-2">
                              <ChannelIcon id={c.id} size={15} />
                            </span>
                            <span class="leading-tight">
                              <span class="block text-[0.875rem] font-semibold text-ink">{c.name}</span>
                              {c.note && <span class="block text-[0.75rem] text-ink-faint">{c.note}</span>}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    {hasSoon ? (
                      <div class="flex flex-col rounded-xl bg-surface-2 p-4">
                        <span class="soon-tag self-start">Coming soon</span>
                        <div class="mt-4 flex items-center gap-1.5" aria-hidden="true">
                          {soonNamed.map((c) => (
                            <span class="grid h-8 w-8 place-items-center rounded-lg border border-dashed border-line-strong bg-surface">
                              <ChannelIcon id={c.id} size={15} />
                            </span>
                          ))}
                        </div>
                        <p class="mt-3 text-[0.8125rem] leading-snug text-ink-muted">{soonText}.</p>
                        <a href="#channels" data-dd-link class="mt-auto inline-flex items-center gap-1.5 pt-5 text-[0.8125rem] font-semibold text-accent hover:underline">
                          See all channels
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h13m0 0-5.5-5.5M18 12l-5.5 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </a>
                      </div>
                    ) : (
                      <a href="#channels" data-dd-link class="mx-5 mb-3 inline-flex items-center gap-1.5 justify-self-start text-[0.8125rem] font-semibold text-accent hover:underline">
                        See all channels
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h13m0 0-5.5-5.5M18 12l-5.5 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      </a>
                    )}
                  </div>
                </div>
              </details>
            </li>
          ) : (
            <li>
              <a href={item.href} class={link}>{item.label}</a>
            </li>
          ),
        )}
      </ul>

      <div class="flex items-center gap-1.5">
        <!-- Wrapped: the Button's own inline-flex would otherwise beat `hidden`. -->
        <div class="hidden sm:block"><Button href={SITE.demoUrl} variant="soft" size="sm" arrow={false}>Book a demo</Button></div>
        <div class="hidden md:block"><Button href={SITE.signupUrl} size="sm" arrow={false}>Get started</Button></div>

        <button
          type="button"
          data-menu-open
          class:list={[iconBtn, 'text-ink lg:hidden']}
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-50 hidden flex-col bg-paper data-[open]:flex lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
>
  <div class="container-t flex h-[var(--nav-h)] items-center justify-between">
    <Logo height={24} />
    <button
      type="button"
      data-menu-close
      class="grid h-10 w-10 place-items-center rounded-lg border border-line bg-surface text-ink"
      aria-label="Close menu"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>
  <ul class="container-t mt-6 flex flex-col gap-1">
    {NAV.map((item) => (
      <li>
        <a href={item.href} data-menu-link class="block border-b border-line py-4 text-2xl font-semibold tracking-tight text-ink">
          {item.label}
        </a>
      </li>
    ))}
  </ul>
  <div class="container-t mt-auto flex flex-col gap-3 pb-10">
    <Button href={SITE.signupUrl}>Get started</Button>
    <Button href={SITE.demoUrl} variant="ghost" arrow={false}>Book a demo</Button>
  </div>
</div>


<script>
  import { lockScroll, getLenis, NAV_OFFSET } from '../../lib/scroll';

  const header = document.getElementById('site-nav')!;
  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Channels dropdown -----------------------------------------------------
  // A native <details>, so it opens without JS. Script adds hover-to-open on
  // mouse, Escape, outside click, and closing when focus moves elsewhere.
  header.querySelectorAll<HTMLDetailsElement>('[data-nav-dd]').forEach((dd) => {
    const summary = dd.querySelector('summary')!;
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    let closeTimer = 0;
    let openedByHover = false;

    const close = () => {
      dd.open = false;
      openedByHover = false;
    };

    dd.addEventListener('mouseenter', () => {
      if (!fine.matches) return;
      clearTimeout(closeTimer);
      if (!dd.open) {
        dd.open = true;
        openedByHover = true;
      }
    });
    dd.addEventListener('mouseleave', () => {
      if (!fine.matches || !openedByHover) return;
      closeTimer = window.setTimeout(close, 180);
    });
    // A click after a hover-open pins the panel instead of toggling it shut.
    summary.addEventListener('click', (e) => {
      if (openedByHover) {
        e.preventDefault();
        openedByHover = false;
      }
    });
    dd.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dd.open) {
        close();
        summary.focus();
      }
    });
    dd.addEventListener('focusout', (e) => {
      if (!dd.contains(e.relatedTarget as Node | null)) close();
    });
    document.addEventListener('click', (e) => {
      if (dd.open && !dd.contains(e.target as Node)) close();
    });
    dd.querySelectorAll('[data-dd-link]').forEach((a) => a.addEventListener('click', close));
  });

  // Mobile menu -----------------------------------------------------------
  const menu = document.getElementById('mobile-menu')!;
  const openBtn = header.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const closeBtn = menu.querySelector<HTMLButtonElement>('[data-menu-close]')!;

  const setOpen = (open: boolean) => {
    menu.toggleAttribute('data-open', open);
    openBtn.setAttribute('aria-expanded', String(open));
    lockScroll(open);
    if (open) closeBtn.focus();
    else openBtn.focus();
  };

  openBtn.addEventListener('click', () => setOpen(true));
  closeBtn.addEventListener('click', () => setOpen(false));
  menu.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  menu.querySelectorAll<HTMLAnchorElement>('[data-menu-link]').forEach((a) =>
    a.addEventListener('click', (e) => {
      const href = a.getAttribute('href')!;
      setOpen(false);
      const lenis = getLenis();
      if (lenis) {
        e.preventDefault();
        lenis.scrollTo(href, { offset: NAV_OFFSET });
      }
    }),
  );
</script>
