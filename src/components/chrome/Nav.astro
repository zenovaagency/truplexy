---
import {
  ArrowRight,
  BookOpen,
  Braces,
  CalendarDays,
  Clock,
  Code,
  Headset,
  History,
  Inbox,
  Mail,
  MessagesSquare,
  MousePointerClick,
  Rocket,
  Webhook,
  type LucideIcon,
} from 'lucide-react';
import Logo from './Logo.astro';
import Button from '../ui/Button.astro';
import ChannelIcon from '../ui/ChannelIcon';
import { CHANGELOG_HREF, DOCS_LINKS, NAV, PRODUCT_LINKS, SITE, navHref } from '../../data/site';
import { CHANGELOG, formatChangeDate } from '../../data/changelog';
import { LIVE_CHANNELS, SOON_CHANNELS } from '../../data/channels';
import { channelHref } from '../../data/setup-guides';

// Channels dropdown: every live channel by name, the flagship upcoming
// messaging apps by name, the rest as a count. All read from the registry.
// With nothing upcoming, the live list takes the full panel in two columns.
const FLAGSHIP_SOON: string[] = ['whatsapp', 'messenger', 'instagram'];
const hasSoon = SOON_CHANNELS.length > 0;
const soonNamed = SOON_CHANNELS.filter((c) => FLAGSHIP_SOON.includes(c.id));
const soonMore = SOON_CHANNELS.length - soonNamed.length;
const soonText = soonNamed.map((c) => c.name).join(', ') + (soonMore > 0 ? ` and ${soonMore} more` : '');

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const onHome = path === '/';
const isCurrent = (match: string[]) => match.some((m) => path === m || path.startsWith(`${m}/`));

const ICON: Record<string, LucideIcon> = {
  '#features': MessagesSquare,
  '#try': MousePointerClick,
  '#handoff': Headset,
  '#inbox': Inbox,
  '#continuous': Clock,
  '/docs': BookOpen,
  '/docs#quickstart': Rocket,
  '/docs/web-sdk': Code,
  '/docs/api': Braces,
  '/docs/webhooks': Webhook,
};
// The live demo gets the Product panel's side card instead of a row.
const productRows = PRODUCT_LINKS.filter((l) => l.href !== '#try').map((l) => ({ ...l, Icon: ICON[l.href] }));
const docsRows = DOCS_LINKS.map((l) => ({ ...l, Icon: ICON[l.href] }));
const latest = CHANGELOG[0];

const link =
  'inline-flex items-center gap-1 rounded-lg px-3 py-2 text-[0.875rem] font-medium text-ink-muted transition-colors hover:text-ink';
const panel =
  'card absolute left-1/2 top-[calc(100%+14px)] -translate-x-1/2 !rounded-2xl p-2 !shadow-[var(--shadow-lg)] before:absolute before:inset-x-0 before:-top-4 before:h-4';
const row = 'flex items-start gap-3 rounded-lg px-2 py-2 transition-colors hover:bg-surface-2';
const tile = 'grid h-8 w-8 flex-none place-items-center rounded-lg border border-line bg-surface-2 text-ink';
const more = 'inline-flex items-center gap-1.5 text-[0.8125rem] font-semibold text-accent hover:underline';
const mobileLink = 'flex items-center gap-3 rounded-lg py-2.5 text-[1.0625rem] font-medium text-ink';
---

<header id="site-nav" class="group/nav fixed inset-x-0 top-3 z-50 sm:top-5">
  <div class="container-t">
    <nav
      class="mx-auto flex h-14 bg-surface max-w-[1120px] items-center justify-between gap-4 rounded-2xl border border-line pl-4 pr-2 shadow-[var(--shadow-sm)] transition-shadow duration-300 group-data-[scrolled]/nav:shadow-[var(--shadow-md)]"
      aria-label="Primary"
    >
      <a href="/" class="-ml-1 flex rounded-md p-1" aria-label="Truplexy home">
        <Logo height={24} alt="" />
      </a>

      <ul class="hidden items-center gap-0.5 lg:flex">
        {NAV.map((item) =>
          item.menu ? (
            <li class="relative">
              <details data-nav-dd class="group/dd">
                <summary
                  data-current={isCurrent(item.match) || undefined}
                  class:list={[link, 'cursor-pointer list-none data-[current]:text-ink group-open/dd:text-ink [&::-webkit-details-marker]:hidden']}
                >
                  {item.label}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 group-open/dd:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>

                {item.menu === 'product' && (
                  <div class:list={[panel, 'w-[600px]']}>
                    <div class="grid grid-cols-[1.35fr_1fr] gap-2">
                      <ul class="grid gap-0.5 p-1.5">
                        {productRows.map(({ label, href, blurb, Icon }) => (
                          <li>
                            <a href={navHref(href, onHome)} data-dd-link class={row}>
                              <span class={tile}><Icon size={15} strokeWidth={1.9} aria-hidden="true" /></span>
                              <span class="leading-tight">
                                <span class="block text-[0.875rem] font-semibold text-ink">{label}</span>
                                <span class="mt-0.5 block text-[0.75rem] text-ink-faint">{blurb}</span>
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                      <div class="flex flex-col rounded-xl bg-surface-2 p-4">
                        <p class="mono text-[0.68rem] text-ink-faint">Live demo</p>
                        <p class="mt-3 text-[1rem] font-semibold leading-snug tracking-tight text-ink">Be the customer.</p>
                        <p class="mt-1.5 text-[0.8125rem] leading-snug text-ink-muted">Ask the assistant anything and watch it hand off to a person.</p>
                        <a href={navHref('#try', onHome)} data-dd-link class:list={[more, 'mt-auto pt-5']}>
                          Try it now <ArrowRight size={13} strokeWidth={2} aria-hidden="true" />
                        </a>
                      </div>
                    </div>
                  </div>
                )}

                {item.menu === 'channels' && (
                  <div class:list={[panel, 'w-[540px]']}>
                    <div class:list={['grid gap-2', hasSoon && 'grid-cols-[1.15fr_1fr]']}>
                      <div class="rounded-xl p-3">
                        <p class="mono flex items-center gap-2 text-[0.68rem] text-ink-faint"><span class="live-dot" aria-hidden="true"></span>Live now</p>
                        <ul class:list={['mt-3 grid gap-1', !hasSoon && 'grid-cols-2']}>
                          {LIVE_CHANNELS.map((c) => (
                            <li>
                              <a href={channelHref(c.id)} data-dd-link class="flex items-center gap-3 rounded-lg px-2 py-1.5 transition-colors hover:bg-surface-2">
                                <span class="grid h-8 w-8 flex-none place-items-center rounded-lg border border-line bg-surface-2">
                                  <ChannelIcon id={c.id} size={15} />
                                </span>
                                <span class="leading-tight">
                                  <span class="block text-[0.875rem] font-semibold text-ink">{c.name}</span>
                                  {c.note && <span class="block text-[0.75rem] text-ink-faint">{c.note}</span>}
                                </span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>

                      {hasSoon ? (
                        <div class="flex flex-col rounded-xl bg-surface-2 p-4">
                          <span class="soon-tag self-start">Coming soon</span>
                          <div class="mt-4 flex items-center gap-1.5" aria-hidden="true">
                            {soonNamed.map((c) => (
                              <span class="grid h-8 w-8 place-items-center rounded-lg border border-dashed border-line-strong bg-surface">
                                <ChannelIcon id={c.id} size={15} />
                              </span>
                            ))}
                          </div>
                          <p class="mt-3 text-[0.8125rem] leading-snug text-ink-muted">{soonText}.</p>
                          <a href="/channels" data-dd-link class:list={[more, 'mt-auto pt-5']}>
                            See all channels <ArrowRight size={13} strokeWidth={2} aria-hidden="true" />
                          </a>
                        </div>
                      ) : (
                        <a href="/channels" data-dd-link class:list={[more, 'mx-5 mb-3 justify-self-start']}>
                          See all channels <ArrowRight size={13} strokeWidth={2} aria-hidden="true" />
                        </a>
                      )}
                    </div>
                  </div>
                )}

                {item.menu === 'resources' && (
                  <div class:list={[panel, 'w-[580px]']}>
                    <div class="grid grid-cols-[1.35fr_1fr] gap-2">
                      <div class="p-1.5">
                        <p class="mono px-2 pt-1.5 text-[0.68rem] text-ink-faint">Docs</p>
                        <ul class="mt-1.5 grid gap-0.5">
                          {docsRows.map(({ label, href, blurb, Icon }) => (
                            <li>
                              <a href={href} data-dd-link class={row}>
                                <span class={tile}><Icon size={15} strokeWidth={1.9} aria-hidden="true" /></span>
                                <span class="leading-tight">
                                  <span class="block text-[0.875rem] font-semibold text-ink">{label}</span>
                                  <span class="mt-0.5 block text-[0.75rem] text-ink-faint">{blurb}</span>
                                </span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                      <div class="flex flex-col gap-1 rounded-xl bg-surface-2 p-2">
                        <a href={CHANGELOG_HREF} data-dd-link class="block rounded-lg p-2.5 transition-colors hover:bg-surface">
                          <span class="flex items-center gap-2 text-[0.875rem] font-semibold text-ink">
                            <History size={15} strokeWidth={1.9} aria-hidden="true" /> Changelog
                          </span>
                          {latest && (
                            <span class="mt-2 block text-[0.8125rem] leading-snug text-ink-muted">
                              <span class="mono block text-[0.625rem] text-ink-faint">Latest · {formatChangeDate(latest.date)}</span>
                              <span class="mt-1 block">{latest.title}</span>
                            </span>
                          )}
                        </a>
                        <div class="mx-2.5 border-t border-line"></div>
                        <a href={SITE.demoUrl} data-dd-link class="flex items-center gap-2 rounded-lg p-2.5 text-[0.875rem] font-semibold text-ink transition-colors hover:bg-surface">
                          <CalendarDays size={15} strokeWidth={1.9} aria-hidden="true" /> Book a demo
                        </a>
                        <a href={`mailto:${SITE.email}`} data-dd-link class="flex items-center gap-2 rounded-lg p-2.5 text-[0.875rem] font-semibold text-ink transition-colors hover:bg-surface">
                          <Mail size={15} strokeWidth={1.9} aria-hidden="true" /> Contact us
                        </a>
                      </div>
                    </div>
                  </div>
                )}
              </details>
            </li>
          ) : (
            <li>
              <a href={item.href} aria-current={isCurrent(item.match) ? 'page' : undefined} class:list={[link, 'aria-[current=page]:text-ink']}>{item.label}</a>
            </li>
          ),
        )}
      </ul>

      <div class="flex items-center gap-1.5">
        <!-- Wrapped: the Button's own inline-flex would otherwise beat `hidden`. -->
        <div class="hidden sm:block"><Button href={SITE.dashboardUrl} variant="ghost" size="sm" arrow={false}>Sign in</Button></div>
        <div class="hidden sm:block"><Button href={SITE.signupUrl} size="sm" arrow={false}>Get started</Button></div>

        <button
          type="button"
          data-menu-open
          class="btn btn-quiet btn-icon h-10 w-10 rounded-lg text-ink lg:hidden"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-50 hidden flex-col bg-paper data-[open]:flex lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
>
  <div class="container-t flex h-[var(--nav-h)] flex-none items-center justify-between">
    <Logo height={24} />
    <button
      type="button"
      data-menu-close
      class="btn btn-ghost btn-icon h-10 w-10 rounded-lg"
      aria-label="Close menu"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>

  <!-- data-lenis-prevent: the page's smooth scroll is stopped while the menu is open; this list scrolls natively. -->
  <ul class="container-t mt-4 flex-1 overflow-y-auto overscroll-contain" data-lenis-prevent>
    {NAV.map((item) => (
      <li class="border-b border-line">
        {item.menu ? (
          <details class="group/m">
            <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-2xl font-semibold tracking-tight text-ink [&::-webkit-details-marker]:hidden">
              {item.label}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink-faint transition-transform duration-200 group-open/m:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <ul class:list={['pb-4', item.menu === 'channels' && 'grid grid-cols-2 gap-x-4']}>
              {item.menu === 'product' &&
                PRODUCT_LINKS.map((l) => (
                  <li><a href={navHref(l.href, onHome)} data-menu-link class={mobileLink}>{l.label}</a></li>
                ))}
              {item.menu === 'channels' && (
                <>
                  {LIVE_CHANNELS.map((c) => (
                    <li>
                      <a href={channelHref(c.id)} data-menu-link class={mobileLink}>
                        <ChannelIcon id={c.id} size={16} />
                        {c.name}
                      </a>
                    </li>
                  ))}
                  <li class="col-span-2"><a href="/channels" data-menu-link class:list={[more, 'pt-2 text-[0.95rem]']}>See all channels <ArrowRight size={14} strokeWidth={2} aria-hidden="true" /></a></li>
                </>
              )}
              {item.menu === 'resources' && (
                <>
                  {DOCS_LINKS.map((l) => (
                    <li><a href={l.href} data-menu-link class={mobileLink}>{l.label}</a></li>
                  ))}
                  <li><a href={CHANGELOG_HREF} data-menu-link class={mobileLink}>Changelog</a></li>
                  <li><a href={SITE.demoUrl} data-menu-link class={mobileLink}>Book a demo</a></li>
                </>
              )}
            </ul>
          </details>
        ) : (
          <a href={item.href} aria-current={isCurrent(item.match) ? 'page' : undefined} data-menu-link class="block py-4 text-2xl font-semibold tracking-tight text-ink">
            {item.label}
          </a>
        )}
      </li>
    ))}
  </ul>

  <div class="container-t flex flex-none flex-col gap-3 pb-10 pt-6">
    <Button href={SITE.signupUrl}>Get started</Button>
    <Button href={SITE.dashboardUrl} variant="ghost" arrow={false}>Sign in</Button>
  </div>
</div>


<script>
  import { lockScroll, getLenis, NAV_OFFSET } from '../../lib/scroll';

  const header = document.getElementById('site-nav')!;
  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Dropdowns -------------------------------------------------------------
  // Native <details>, so they open without JS. Script adds hover-to-open on
  // mouse, Escape, outside click, and closing when focus moves elsewhere.
  header.querySelectorAll<HTMLDetailsElement>('[data-nav-dd]').forEach((dd) => {
    const summary = dd.querySelector('summary')!;
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    let closeTimer = 0;
    let openedByHover = false;

    const close = () => {
      dd.open = false;
      openedByHover = false;
    };

    dd.addEventListener('mouseenter', () => {
      if (!fine.matches) return;
      clearTimeout(closeTimer);
      if (!dd.open) {
        dd.open = true;
        openedByHover = true;
      }
    });
    dd.addEventListener('mouseleave', () => {
      if (!fine.matches || !openedByHover) return;
      closeTimer = window.setTimeout(close, 180);
    });
    // A click after a hover-open pins the panel instead of toggling it shut.
    summary.addEventListener('click', (e) => {
      if (openedByHover) {
        e.preventDefault();
        openedByHover = false;
      }
    });
    dd.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dd.open) {
        close();
        summary.focus();
      }
    });
    dd.addEventListener('focusout', (e) => {
      if (!dd.contains(e.relatedTarget as Node | null)) close();
    });
    document.addEventListener('click', (e) => {
      if (dd.open && !dd.contains(e.target as Node)) close();
    });
    dd.querySelectorAll('[data-dd-link]').forEach((a) => a.addEventListener('click', close));
  });

  // Mobile menu -----------------------------------------------------------
  const menu = document.getElementById('mobile-menu')!;
  const openBtn = header.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const closeBtn = menu.querySelector<HTMLButtonElement>('[data-menu-close]')!;

  const setOpen = (open: boolean) => {
    menu.toggleAttribute('data-open', open);
    openBtn.setAttribute('aria-expanded', String(open));
    lockScroll(open);
    if (open) closeBtn.focus();
    else openBtn.focus();
  };

  openBtn.addEventListener('click', () => setOpen(true));
  closeBtn.addEventListener('click', () => setOpen(false));
  menu.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  menu.querySelectorAll<HTMLAnchorElement>('[data-menu-link]').forEach((a) =>
    a.addEventListener('click', (e) => {
      const href = a.getAttribute('href')!;
      setOpen(false);
      const lenis = getLenis();
      // Only same-page sections glide; links to other pages just navigate.
      if (lenis && href.startsWith('#')) {
        e.preventDefault();
        lenis.scrollTo(href, { offset: NAV_OFFSET });
      }
    }),
  );
</script>
