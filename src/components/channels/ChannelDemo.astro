---
import ChannelIcon from '../ui/ChannelIcon';
import type { ChannelId } from '../../data/channels';
import type { DemoLine } from '../../data/channel-pages';

/**
 * A sample conversation on one channel, played line by line when it scrolls
 * into view. Without JavaScript, or with reduced motion, every line shows at
 * once.
 */
interface Props {
  id: ChannelId;
  context: string;
  lines: DemoLine[];
}
const { id, context, lines } = Astro.props;
---

<figure class="channel-demo" data-channel-demo>
  <div class="demo-head">
    <span class="demo-icon" aria-hidden="true"><ChannelIcon id={id} size={18} /></span>
    <span class="min-w-0 flex-1 truncate font-semibold text-ink">{context}</span>
    <button type="button" class="demo-replay" data-replay hidden>Replay</button>
  </div>
  <div class="demo-body">
    {lines.map((l) =>
      l.from === 'event' ? (
        <p class="demo-event" data-line>{l.text}</p>
      ) : (
        <div class={`bubble bubble-${l.from} whitespace-pre-line`} data-line>
          {l.author && <span class="mb-0.5 block text-[0.72rem] font-semibold opacity-70">{l.author}</span>}
          {l.text}
        </div>
      ),
    )}
  </div>
  <figcaption class="demo-caption mono">Sample conversation · fictional store and customers</figcaption>
</figure>

<style>
  .channel-demo {
    max-width: 560px;
    border: 1px solid var(--color-line);
    border-radius: 20px;
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  .demo-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-surface-2);
    font-size: 0.875rem;
  }
  .demo-icon {
    display: grid;
    flex: none;
    width: 30px;
    height: 30px;
    place-items: center;
    border: 1px solid var(--color-line);
    border-radius: 9px;
    background: var(--color-surface);
  }
  .demo-replay {
    flex: none;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-accent);
  }
  .demo-replay:hover {
    text-decoration: underline;
  }
  .demo-body {
    display: flex;
    min-height: 220px;
    flex-direction: column;
    gap: 10px;
    padding: 18px 16px;
  }
  .demo-event {
    align-self: center;
    margin: 4px 0;
    padding: 3px 10px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface-2);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ink-faint);
    text-align: center;
  }
  .demo-caption {
    padding: 0 16px 14px;
    font-size: 0.66rem;
    color: var(--color-ink-faint);
  }
  [data-line] {
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .is-waiting [data-line]:not(.is-shown) {
    opacity: 0;
    transform: translateY(6px);
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const demo of document.querySelectorAll<HTMLElement>('[data-channel-demo]')) {
    const lines = [...demo.querySelectorAll<HTMLElement>('[data-line]')];
    const replay = demo.querySelector<HTMLButtonElement>('[data-replay]')!;
    if (reduce || lines.length < 2) continue;

    let timers: number[] = [];
    const play = () => {
      timers.forEach(clearTimeout);
      timers = [];
      lines.forEach((l) => l.classList.remove('is-shown'));
      demo.classList.add('is-waiting');
      replay.hidden = true;
      lines.forEach((l, i) => {
        timers.push(window.setTimeout(() => l.classList.add('is-shown'), 250 + i * 900));
      });
      timers.push(window.setTimeout(() => (replay.hidden = false), 250 + lines.length * 900));
    };

    demo.classList.add('is-waiting');
    replay.addEventListener('click', play);
    new IntersectionObserver((entries, io) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        play();
      }
    }, { threshold: 0.35 }).observe(demo);
  }
</script>
