---
import { channel } from '../../data/channels';
import type { ChannelDemoData, OverviewId } from '../../data/channel-pages';
import SiteWidget from './demo/SiteWidget.astro';
import PhoneChat from './demo/PhoneChat.astro';
import TeamChat from './demo/TeamChat.astro';
import EmailThread from './demo/EmailThread.astro';
import HelpdeskTicket from './demo/HelpdeskTicket.astro';
import type { HelpdeskVariant, PhoneVariant, SiteVariant, TeamVariant } from './demo/shared';

/**
 * A sample conversation drawn the way it looks on the platform once Truplexy
 * is added: the widget on the store's site, the customer's phone, the team's
 * workspace, an inbox or a help desk. Lines play one by one when it scrolls
 * into view; without JavaScript, or with reduced motion, they all show at once.
 */
type Skin =
  | { skin: 'site'; variant: SiteVariant }
  | { skin: 'phone'; variant: PhoneVariant }
  | { skin: 'team'; variant: TeamVariant }
  | { skin: 'email' }
  | { skin: 'helpdesk'; variant: HelpdeskVariant };

const SKIN: Record<OverviewId, Skin> = {
  web: { skin: 'site', variant: 'site' },
  shopify: { skin: 'site', variant: 'shopify' },
  woocommerce: { skin: 'site', variant: 'woocommerce' },
  wordpress: { skin: 'site', variant: 'wordpress' },
  whatsapp: { skin: 'phone', variant: 'whatsapp' },
  telegram: { skin: 'phone', variant: 'telegram' },
  messenger: { skin: 'phone', variant: 'messenger' },
  instagram: { skin: 'phone', variant: 'instagram' },
  discord: { skin: 'team', variant: 'discord' },
  slack: { skin: 'team', variant: 'slack' },
  teams: { skin: 'team', variant: 'teams' },
  email: { skin: 'email' },
  zendesk: { skin: 'helpdesk', variant: 'zendesk' },
  hubspot: { skin: 'helpdesk', variant: 'hubspot' },
};

interface Props {
  id: OverviewId;
  demo: ChannelDemoData;
}
const { id, demo } = Astro.props;
const s = SKIN[id];
---

<figure class="channel-demo" data-channel-demo aria-label={`Sample conversation on ${channel(id).name}`}>
  <div class={`demo-stage is-${s.skin}`}>
    {s.skin === 'site' && <SiteWidget variant={s.variant} demo={demo} />}
    {s.skin === 'phone' && <PhoneChat variant={s.variant} demo={demo} />}
    {s.skin === 'team' && <TeamChat variant={s.variant} demo={demo} />}
    {s.skin === 'email' && <EmailThread demo={demo} />}
    {s.skin === 'helpdesk' && <HelpdeskTicket variant={s.variant} demo={demo} />}
  </div>
  <figcaption class="demo-caption">
    <span class="mono">Illustration · fictional store and customers</span>
    <button type="button" class="demo-replay" data-replay hidden>Replay</button>
  </figcaption>
</figure>

<style>
  .channel-demo {
    margin: 0;
  }
  .demo-stage {
    display: flex;
    justify-content: center;
    padding: 28px;
    border: 1px solid var(--color-line);
    border-radius: 20px;
    background:
      radial-gradient(120% 80% at 50% 0%, var(--color-surface) 0%, transparent 70%),
      var(--color-surface-2);
  }
  .demo-stage.is-phone {
    padding: 32px 16px;
  }
  .demo-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 4px 0;
    font-size: 0.7rem;
    color: var(--color-ink-faint);
  }
  .demo-replay {
    flex: none;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent);
  }
  .demo-replay:hover {
    text-decoration: underline;
  }
  .channel-demo :global([data-line]) {
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .channel-demo:global(.is-waiting) :global([data-line]:not(.is-shown)) {
    opacity: 0;
    transform: translateY(6px);
  }

  @media (max-width: 560px) {
    .demo-stage {
      padding: 14px 10px;
      border-radius: 16px;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const demo of document.querySelectorAll<HTMLElement>('[data-channel-demo]')) {
    const lines = [...demo.querySelectorAll<HTMLElement>('[data-line]')];
    const replay = demo.querySelector<HTMLButtonElement>('[data-replay]')!;
    if (reduce || lines.length < 2) continue;

    let timers: number[] = [];
    const play = () => {
      timers.forEach(clearTimeout);
      timers = [];
      lines.forEach((l) => l.classList.remove('is-shown'));
      demo.classList.add('is-waiting');
      replay.hidden = true;
      lines.forEach((l, i) => {
        timers.push(window.setTimeout(() => l.classList.add('is-shown'), 250 + i * 900));
      });
      timers.push(window.setTimeout(() => (replay.hidden = false), 250 + lines.length * 900));
    };

    demo.classList.add('is-waiting');
    replay.addEventListener('click', play);
    new IntersectionObserver((entries, io) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        play();
      }
    }, { threshold: 0.35 }).observe(demo);
  }
</script>
