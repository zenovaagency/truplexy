---
import { ArrowRight, Lock, RotateCcw, ShoppingBag, X } from 'lucide-react';
import type { ChannelDemoData } from '../../../data/channel-pages';
import type { SiteVariant } from './shared';
import { getImage } from 'astro:assets';
import bubbly from '../../../assets/brand/bubbly-avatar.png';

/**
 * A page of the store's own site with the Truplexy chat widget open on it,
 * drawn from the widget's real styles (sdk/packages/web/src/styles.ts) and
 * default labels (sdk/packages/web/src/labels.ts), in the site's ink theme
 * (the colours the home page's own chat uses), with Bubbly as the avatar.
 */

interface Props {
  variant: SiteVariant;
  demo: ChannelDemoData;
}
const { variant, demo } = Astro.props;
const url = `loomandlane.example${demo.page ?? '/'}`;
// Bubbly, the assistant, speaks for the store wherever the AI does.
const avatar = await getImage({ src: bubbly, width: 72, format: 'webp' });
const product = variant === 'shopify' ? { name: 'Atlas Jacket', tone: '#2f3a33' } : { name: 'Linen Shirt', tone: '#c9b99a' };
---

<div class={`site v-${variant}`}>
  <div class="bw-bar" aria-hidden="true">
    <span class="bw-dots"><i></i><i></i><i></i></span>
    <span class="bw-url"><Lock size={11} />{url}</span>
  </div>

  <div class="bw-page">
    <div class="pg" aria-hidden="true">
      <div class="pg-nav">
        <b>Loom &amp; Lane</b>
        <span>Shop</span><span>Journal</span><span>Help</span>
        {variant !== 'wordpress' && <ShoppingBag size={15} />}
      </div>

      {variant === 'site' && (
        <div class="pg-main">
          <p class="pg-kicker">Your account</p>
          <p class="pg-h">Billing</p>
          <div class="pg-card"><i style="width:45%"></i><i style="width:70%"></i><i style="width:30%"></i></div>
          <div class="pg-card"><i style="width:55%"></i><i style="width:40%"></i></div>
        </div>
      )}

      {(variant === 'shopify' || variant === 'woocommerce') && (
        <div class="pg-main pg-product">
          <span class="pg-img" style={`--tone:${product.tone}`}></span>
          <div>
            <p class="pg-h">{product.name}</p>
            <i class="pg-line" style="width:50%"></i>
            <span class="pg-sizes"><span>S</span><span>M</span><span>L</span><span>XL</span></span>
            <span class="pg-buy">Add to cart</span>
          </div>
        </div>
      )}

      {variant === 'wordpress' && (
        <div class="pg-main">
          <p class="pg-kicker">Journal</p>
          <p class="pg-h">Caring for linen</p>
          {[92, 88, 95, 60, 0, 90, 84, 70].map((w) => (w ? <i class="pg-line" style={`width:${w}%`}></i> : <br />))}
        </div>
      )}
    </div>

    <div class="tx">
      <div class="tx-panel">
        <div class="tx-head">
          <img class="tx-avatar" src={avatar.src} width="34" height="34" alt="" />
          <span class="tx-heading">
            <span class="tx-title">Loom &amp; Lane</span>
            <span class="tx-sub">Ask us anything. We usually reply in seconds.</span>
          </span>
          <span class="tx-icon" aria-hidden="true"><RotateCcw size={16} /></span>
          <span class="tx-icon" aria-hidden="true"><X size={18} /></span>
        </div>
        <div class="tx-log">
          {demo.lines.map((l) =>
            l.from === 'event' ? (
              <p class="tx-notice" data-line>{l.text}</p>
            ) : (
              <div class={`tx-msg ${l.from === 'customer' ? 'user' : 'assistant'} ${l.from === 'agent' ? 'agent' : ''}`} data-line>
                {l.from === 'agent' && l.author && <span class="tx-who">{l.author}</span>}
                <div class="tx-bubble whitespace-pre-line">{l.text}</div>
              </div>
            ),
          )}
        </div>
        <div class="tx-composer" aria-hidden="true">
          <span class="tx-input">Write a message…</span>
          <span class="tx-send"><ArrowRight size={19} /></span>
        </div>
        <p class="tx-brand" aria-hidden="true">Powered by Truplexy</p>
      </div>
      <span class="tx-launcher" aria-hidden="true"><X size={24} /></span>
    </div>
  </div>
</div>

<style>
  .site {
    width: 100%;
    overflow: hidden;
    border: 1px solid #d9dce5;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 30px 60px -28px rgb(14 18 34 / 0.4);
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  .bw-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 9px 12px;
    border-bottom: 1px solid #e3e6f0;
    background: #f4f5f8;
  }
  .bw-dots { display: flex; gap: 6px; }
  .bw-dots i { width: 11px; height: 11px; border-radius: 50%; background: #ff5f57; }
  .bw-dots i:nth-child(2) { background: #febc2e; }
  .bw-dots i:nth-child(3) { background: #28c840; }
  .bw-url {
    display: flex;
    min-width: 0;
    flex: 1;
    max-width: 360px;
    align-items: center;
    gap: 6px;
    overflow: hidden;
    padding: 4px 12px;
    border-radius: 999px;
    background: #fff;
    font-size: 12px;
    color: #5a6080;
    white-space: nowrap;
  }

  .bw-page {
    position: relative;
    height: 600px;
    background: #fbfaf7;
  }

  /* The store's own page, drawn faintly behind the widget. */
  .pg {
    height: 100%;
    padding: 0 28px;
    opacity: 0.75;
    color: #2a2a2a;
  }
  .pg-nav {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 16px 0;
    border-bottom: 1px solid #ebe7de;
    font-size: 12.5px;
    color: #6b665c;
  }
  .pg-nav b { margin-right: auto; font-family: Georgia, serif; font-size: 16px; color: #2a2a2a; }
  .pg-main { max-width: 46%; padding-top: 34px; }
  .pg-kicker { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #9a9384; }
  .pg-h { margin: 6px 0 16px; font-family: Georgia, serif; font-size: 26px; line-height: 1.15; }
  .pg-line, .pg-card i {
    display: block;
    height: 8px;
    margin: 10px 0;
    border-radius: 4px;
    background: #e6e1d6;
  }
  .pg-card { margin-bottom: 14px; padding: 6px 14px; border: 1px solid #ebe7de; border-radius: 10px; background: #fff; }
  .pg-product { display: grid; grid-template-columns: 0.9fr 1fr; gap: 20px; max-width: 54%; }
  .pg-img {
    aspect-ratio: 3 / 4;
    border-radius: 8px;
    background: linear-gradient(160deg, color-mix(in srgb, var(--tone) 70%, #fff), var(--tone));
  }
  .pg-sizes { display: flex; gap: 6px; margin: 16px 0; }
  .pg-sizes span { padding: 4px 8px; border: 1px solid #d8d2c4; border-radius: 6px; font-size: 11px; }
  .pg-buy { display: block; padding: 9px; border-radius: 8px; background: #2a2a2a; color: #fff; font-size: 12px; text-align: center; }
  .v-woocommerce .pg-buy { background: #7f54b3; }

  /* The widget: the SDK's stylesheet with the site's theme (see
     BubblyChat.astro): ink accent on warm neutrals. */
  .tx {
    --tx-accent: #0a0a0a;
    --tx-surface: #f3efe8;
    --tx-ink: #0a0a0a;
    --tx-muted: #55514b;
    --tx-line: #e7e2d9;
    position: absolute;
    top: 16px;
    right: 20px;
    bottom: 20px;
    display: flex;
    width: min(340px, calc(100% - 40px));
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--tx-ink);
  }
  .tx-panel {
    display: flex;
    width: 100%;
    min-height: 0;
    flex: 1;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--tx-line);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 24px 60px -12px rgb(14 18 34 / 0.28), 0 4px 14px rgb(14 18 34 / 0.08);
  }
  .tx-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 10px 12px 14px;
    background: var(--tx-accent);
    color: #fff;
  }
  .tx-avatar {
    display: grid;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
  }
  .tx-heading { display: flex; min-width: 0; flex: 1; flex-direction: column; }
  .tx-title { font-size: 15px; font-weight: 700; line-height: 1.25; }
  .tx-sub { overflow: hidden; font-size: 12px; opacity: 0.85; text-overflow: ellipsis; white-space: nowrap; }
  .tx-icon { display: grid; width: 28px; height: 28px; place-items: center; opacity: 0.85; }
  .tx-log {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
    padding: 16px 14px 8px;
  }
  .tx-msg { display: flex; max-width: 86%; flex-direction: column; gap: 4px; }
  .tx-msg.user { align-self: flex-end; align-items: flex-end; }
  .tx-msg.assistant { align-self: flex-start; }
  .tx-who { padding: 0 4px; font-size: 11.5px; font-weight: 600; color: var(--tx-muted); }
  .tx-bubble {
    padding: 9px 13px;
    border-radius: 16px;
    border-bottom-left-radius: 6px;
    background: var(--tx-surface);
    overflow-wrap: anywhere;
  }
  .user .tx-bubble { border-radius: 16px; border-bottom-right-radius: 6px; background: var(--tx-accent); color: #fff; }
  .agent .tx-bubble { box-shadow: inset 3px 0 0 var(--tx-accent); }
  .tx-notice {
    padding: 8px 12px;
    border-radius: 12px;
    background: var(--tx-surface);
    font-size: 12.5px;
    color: var(--tx-muted);
    text-align: center;
  }
  .tx-composer {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px 6px;
    border-top: 1px solid var(--tx-line);
  }
  .tx-input {
    flex: 1;
    padding: 10px 14px;
    border: 1px solid var(--tx-line);
    border-radius: 14px;
    color: var(--tx-muted);
  }
  .tx-send {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 50%;
    background: var(--tx-accent);
    color: #fff;
  }
  .tx-brand { padding: 2px 12px 9px; font-size: 11px; color: var(--tx-muted); text-align: center; }
  .tx-launcher {
    display: grid;
    width: 54px;
    height: 54px;
    place-items: center;
    border-radius: 50%;
    background: var(--tx-accent);
    color: #fff;
    box-shadow: 0 24px 60px -12px rgb(14 18 34 / 0.28), 0 4px 14px rgb(14 18 34 / 0.08);
  }

  /* On a phone the widget fills the screen, as the real one does. */
  @media (max-width: 560px) {
    .bw-page { height: 560px; }
    .pg { display: none; }
    .tx { inset: 0; width: 100%; }
    .tx-panel { border: 0; border-radius: 0; box-shadow: none; }
    .tx-launcher { display: none; }
  }
</style>
