---
/**
 * Buttons are ink-on-paper rectangles, so the primary is always the
 * highest-contrast element on the page. The decorative blues of the
 * gradient never carry text.
 *
 * Styling lives in the `.btn` classes in global.css, which the React
 * islands share. This component adds the label roll and the arrow.
 */
interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'soft' | 'light' | 'onDark';
  size?: 'md' | 'sm';
  arrow?: boolean;
  class?: string;
}
const { href, variant = 'primary', size = 'md', arrow = true, class: className = '' } = Astro.props;

const variants = {
  primary: 'btn-primary',
  ghost: 'btn-ghost',
  soft: 'btn-soft',
  light: 'btn-light',
  onDark: 'btn-on-dark',
};
---

<a href={href} class:list={['btn', `btn-${size}`, variants[variant], className]}>
  <span class="btn-roll"><span class="btn-text"><slot /></span></span>
  {arrow && (
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="btn-arrow">
      <path d="M5 12h13m0 0-5.5-5.5M18 12l-5.5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
</a>
