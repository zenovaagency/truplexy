---
/**
 * Bubbly, the Truplexy assistant: the glossy animated mascot.
 *
 * The glossy body is built from large blur filters, which are far too
 * costly to redraw every frame. So the body is a pre-rendered image
 * (bubbly-body.png, from bubbly-animated.svg without its face) and only the
 * eyes are live SVG on top. The bob moves the whole wrapper (a composited
 * transform, no repaint); blinking and glancing redraw just the small eye
 * layer.
 *
 * Motion (bubbly.css): a gentle bob, a blink and a glance aside.
 * `look` adds the `.look` hook: a script sets --look-x / --look-y (in the
 * SVG's units, about ±30) on the root to turn the face toward the pointer,
 * which pauses the idle glance. Reduced motion keeps it still.
 */
import { getImage } from 'astro:assets';
import body from '../../assets/brand/bubbly-body.png';
import './bubbly.css';

interface Props {
  size?: number;
  class?: string;
  /** No motion (avatars, thumbnails). */
  still?: boolean;
  /** Face can follow the pointer (set --look-x / --look-y). */
  look?: boolean;
}
const { size = 96, class: className = '', still = false, look = false } = Astro.props;
const img = await getImage({ src: body, width: 256, format: 'webp' });
// The art's box (viewBox 636 × 707).
const height = Math.round((size * 707) / 636);
---

<span class:list={['bubbly', still && 'is-still', look && 'look', className]} style={`width: ${size}px; height: ${height}px;`} aria-hidden="true">
  <span class="bubbly-bob">
    <img src={img.src} alt="" width={size} height={height} decoding="async" draggable="false" />
    <svg viewBox="0 0 636 707" focusable="false">
      <g transform="translate(-194 -144)">
        <g class="tpx-bubbly">
          <g class="face">
            <g class="eyes">
              <g class="eye">
                <ellipse cx="586" cy="470" rx="35" ry="52" fill="#1d1631" transform="rotate(8 586 470)" />
                <circle cx="597.2" cy="448.2" r="10.5" fill="#fff" />
              </g>
              <g class="eye">
                <ellipse cx="690" cy="460" rx="35" ry="52" fill="#1d1631" transform="rotate(8 690 460)" />
                <circle cx="701.2" cy="438.2" r="10.5" fill="#fff" />
              </g>
            </g>
          </g>
        </g>
      </g>
    </svg>
  </span>
</span>
