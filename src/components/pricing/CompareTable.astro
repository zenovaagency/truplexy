---
import { Check } from 'lucide-react';
import Button from '../ui/Button.astro';
import { COMPARISON, FOOTNOTES, PLANS } from '../../data/pricing';

// The featured plan's column is tinted down the whole table; hovering a row
// darkens every cell in it, tinted or not.
const cell = (featured?: boolean) =>
  featured ? 'bg-accent-soft/40 group-hover/row:bg-accent-soft/70' : 'group-hover/row:bg-surface-2';

const listPlans = PLANS.map((p) => p.name).join(', ').replace(/, ([^,]*)$/, ' and $1');

// The label column stays put while the plans scroll sideways on small
// screens; it needs its own background to cover what slides under it.
const label = 'sticky left-0 z-[1] bg-surface text-left';
---

<div>
  <!-- Scrolls sideways below lg. From lg up nothing clips it, so the header
       row can stick to the top as the page scrolls. Its cells carry the nav's
       height as padding, so stuck, they fill the strip behind the floating
       nav; the negative margin gives that space back while it isn't stuck.
       Whatever sits just above the table must stack over it. -->
  <div class="-mx-[var(--gutter)] px-[var(--gutter)] max-lg:overflow-x-auto lg:-mt-[var(--nav-h)]" data-reveal>
    <table class="w-full min-w-[520px] border-separate border-spacing-0 text-[0.85rem] sm:text-[0.92rem]">
      <caption class="sr-only">Feature comparison of the {listPlans} plans</caption>
      <colgroup>
        <col class="w-[9.5rem] sm:w-[34%]" />
        {PLANS.map(() => <col class="w-[22%]" />)}
      </colgroup>

      <thead>
        <tr>
          <td class:list={[label, 'border-b border-line lg:top-0 lg:z-[3]']}></td>
          {PLANS.map((plan) => (
            <th
              scope="col"
              class="border-b border-line bg-surface px-2 pb-5 pt-2 text-center align-bottom font-normal sm:px-3 lg:sticky lg:top-0 lg:z-[2] lg:pt-[calc(var(--nav-h)+0.5rem)]"
            >
              <span class="flex items-center justify-center gap-2">
                <span class="text-[1.05rem] font-bold tracking-tight text-ink">{plan.name}</span>
                {plan.featured && <span class="chip bg-accent-soft !px-2 !py-0.5 text-[0.66rem] text-accent max-sm:hidden">Popular</span>}
              </span>
              <span class="mt-1 block text-[0.85rem] text-ink-faint">
                <span class="font-semibold text-ink tabular-nums">${plan.price.monthly}</span> / month
              </span>
              <Button href={plan.cta.href} variant={plan.featured ? 'primary' : 'ghost'} size="sm" arrow={false} class="mt-3 w-full">
                {plan.cta.label}
              </Button>
            </th>
          ))}
        </tr>
      </thead>

      {COMPARISON.map((section) => (
        <tbody>
          <tr>
            <th scope="rowgroup" colspan={PLANS.length + 1} class="px-0 pb-3 pt-10 text-left">
              <span class="mono sticky left-0 inline-block text-ink-faint">{section.group}</span>
            </th>
          </tr>
          {section.rows.map((row) => (
            <tr class="group/row">
              <th scope="row" class:list={[label, 'border-t border-line py-3.5 pr-3 font-medium sm:pr-4 text-ink group-hover/row:bg-surface-2']}>
                {row.label}
                {row.note && <sup class="ml-0.5 text-ink-faint" aria-label="See note below">{row.note}</sup>}
              </th>
              {PLANS.map((plan) => {
                const v = row.values[plan.id];
                return (
                  <td class:list={['border-t border-line px-2 py-3.5 text-center sm:px-3 text-ink-muted', cell(plan.featured)]}>
                    {v === true ? (
                      <span class="inline-grid h-[18px] w-[18px] place-items-center rounded-full bg-accent-soft align-middle text-accent">
                        <Check size={11} strokeWidth={3} aria-hidden="true" />
                        <span class="sr-only">Included</span>
                      </span>
                    ) : v === false ? (
                      <span class="text-ink-faint">
                        <span aria-hidden="true">—</span>
                        <span class="sr-only">Not included</span>
                      </span>
                    ) : (
                      <span class="tabular-nums">{v}</span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      ))}
    </table>
  </div>

  <ul class="mt-6 space-y-1 text-[0.85rem] text-ink-faint">
    {Object.entries(FOOTNOTES).map(([mark, text]) => (
      <li><span aria-hidden="true">{mark}</span> {text}</li>
    ))}
  </ul>
</div>
