{
  "name": "truplexy-sdk",
  "private": true,
  "type": "module",
  "description": "Truplexy website SDK: the chat widget, framework wrappers and the server proxy.",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/server",
    "packages/web",
    "packages/react",
    "packages/vue"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces",
    "size": "node scripts/size.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "playground": "node playground/server.mjs",
    "version:sdk": "node scripts/release.mjs version",
    "publish:check": "node scripts/release.mjs check",
    "release": "node scripts/release.mjs publish"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "happy-dom": "^21.0.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
