{
  "name": "@truplexy/server",
  "version": "0.1.1",
  "description": "The server route for the Truplexy chat widget. Keeps your chat key on the server, for Next.js, Nuxt, SvelteKit, Remix, Astro, Express, Cloudflare Workers and any Fetch-API runtime.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "keywords": ["truplexy", "chat", "widget", "support", "nextjs", "nuxt", "sveltekit", "express"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p . --noEmit"
  }
}
