{
  "name": "@truplexy/react",
  "version": "0.1.0",
  "description": "The Truplexy chat widget for React, Next.js, Remix and Gatsby.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "keywords": ["truplexy", "chat", "widget", "react", "nextjs", "support"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@truplexy/web": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "^19.1.0"
  }
}
