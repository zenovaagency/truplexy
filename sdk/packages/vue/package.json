{
  "name": "@truplexy/vue",
  "version": "0.1.0",
  "description": "The Truplexy chat widget for Vue 3 and Nuxt.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "keywords": ["truplexy", "chat", "widget", "vue", "nuxt", "support"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@truplexy/web": "0.1.0"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "vue": "^3.5.0"
  }
}
