{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "site": {
      "root": ".",
      "framework": "astro",
      "routes": [
        { "src": "^/(.+)/$", "status": 308, "headers": { "Location": "/$1" } },
        { "handle": "error" },
        { "src": "/(.*)", "status": 404, "dest": "/404.html" }
      ]
    },
    "dashboard": {
      "root": "dashboard",
      "framework": "vite",
      "headers": [
        {
          "source": "/(.*)",
          "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
        }
      ],
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.truplexy.com" }],
      "destination": "https://truplexy.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": { "pre": "app." } }],
      "destination": { "service": "dashboard" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "site" }
    }
  ]
}
