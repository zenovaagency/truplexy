{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "site": {
      "root": ".",
      "framework": "astro",
      "routes": [
        { "handle": "error" },
        { "src": "/(.*)", "status": 404, "dest": "/404.html" }
      ]
    },
    "dashboard": {
      "root": "dashboard",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": { "pre": "app." } }],
      "destination": { "service": "dashboard" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "site" }
    }
  ]
}
