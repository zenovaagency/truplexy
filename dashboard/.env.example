# Copy to .env.local and fill in. Only browser-safe values belong here:
# never put ADMIN_API_KEY, PLAYGROUND_API_KEY, chat keys or the Supabase
# secret key in a VITE_ variable — they are shipped to every visitor.

# Truplexy API, including the version.
VITE_API_BASE_URL=https://api.truplexy.com/v3

# The Supabase project the API trusts (its SUPABASE_URL), and its
# publishable key (sb_publishable_…, Project Settings → API Keys).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Where this dashboard is served. Invitation links are built from it.
VITE_DASHBOARD_URL=http://localhost:5173

# Cloudflare Turnstile site key (public), for the human check on sign-in, sign-up,
# email links and password reset. The matching secret key goes only into
# Supabase (Authentication → Attack Protection → CAPTCHA). Leave empty to show no
# check; do that only while Supabase's CAPTCHA protection is off, or sign-in fails.
# For local testing, Cloudflare's always-pass key is 1x00000000000000000000AA.
VITE_TURNSTILE_SITE_KEY=

# true runs the dashboard against an in-browser mock API with sample data
# and a role switcher. `npm run dev:mock` sets it for you (.env.mock).
VITE_USE_MOCKS=false

# Paddle Billing. Checkout does not open in the dashboard: Paddle only opens
# checkouts on domains it approved, so the dashboard sends the customer to the
# site's /pay page, which loads Paddle.js (the site's build reads the public
# client-side token from VITE_PADDLE_CLIENT_TOKEN and VITE_PADDLE_ENV). The
# default is the production page; point it at your local site to test sandbox.
# VITE_PAY_PAGE_URL=http://localhost:4321/pay

# Image input (planned): the API does not serve it yet. The dashboard asks the API
# (GET /playground/attachments/config) and shows picture controls only when it says
# so, so nothing needs setting. To leave the "Sending pictures" section out of the
# integration guide altogether:
# VITE_IMAGE_INPUT_GUIDE=hidden
# In demo mode, the mock API serves it only when asked (off, on, plan, no_vision, on-expired):
# VITE_MOCK_IMAGE_INPUT=on
