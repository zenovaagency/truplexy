# Copy to .env.local and fill in. Only browser-safe values belong here:
# never put ADMIN_API_KEY, PLAYGROUND_API_KEY, chat keys or the Supabase
# secret key in a VITE_ variable — they are shipped to every visitor.

# Truplexy API, including the version.
VITE_API_BASE_URL=https://api.zenovasolution.xyz/v2

# The Supabase project the API trusts (its SUPABASE_URL), and its
# publishable key (sb_publishable_…, Project Settings → API Keys).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Where this dashboard is served. Invitation links are built from it.
VITE_DASHBOARD_URL=http://localhost:5173

# true runs the dashboard against an in-browser mock API with sample data
# and a role switcher. `npm run dev:mock` sets it for you (.env.mock).
VITE_USE_MOCKS=false
